(: cell-type Type)
(: bioelectric-state Type)
(: tissue-decision Type)
(: gap-junction-coupling Type)
(: (bioelectric-operad CellType BioElectricState TissueDecision) Type)
(|- ((--> (x quiescent cell-type) bioelectric-state) (stv 1.0 0.9)))
(|- ((--> (x maintenance cell-type) bioelectric-state) (stv 1.0 0.9)))
(|- ((= (--> (x $n1 cell-type) bioelectric-state) (--> (otimes (x $n1 cell-type) cell-type) tissue-decision)) (stv 1.0 0.8)))
(|- ((= (--> (x $n1 cell-type) tissue-decision) (<-R $n1 $n2 cell-type)) (stv 1.0 0.8)))
(|- ((--> (x gap-junction-coupling) bioelectric-state) (stv 1.0 0.9)))
(|- ((= (gap-junction-coupling bioelectric-state1 bioelectric-state2) (tensor bioelectric-state1 bioelectric-state2)) (stv 1.0 0.8)))
(|- ((= (swap bioelectric-state1 bioelectric-state2) (gap-junction-coupling bioelectric-state2 bioelectric-state1)) (stv 1.0 0.8)))