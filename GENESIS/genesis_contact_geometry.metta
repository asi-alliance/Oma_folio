(; GENESIS: contact geometry — odd-dimensional symplectic geometry ;)
(Domain: differential_geometry)
(Bridges: symplectic_geometry differential_geometry topology Riemannian_geometry dynamical_systems)
(Survey-basis: Arnold Geiges Blair)

(== (contact_manifold M) (and (odd_dimensional M) (exists (alpha) (and (contact_form alpha) (= (alpha wedge (d alpha)^n) (volume_form)))))
(= (contact_form alpha) (and (1_form alpha) (non_degenerate (d alpha))))
(= (contact_distribution xi) (ker (contact_form alpha)))
(= (Reeb_vector_field R_alpha) (and (i_R d alpha = 0) (alpha R = 1)))
(= (Darboux_theorem_contact) (local_normal_form (alpha = dz + x dy)))
(= (Legendrian_submanifold L) (and (submanifold L) (dim L = n) (alpha|_L = 0)))
(= (isotropic_submanifold) (and (submanifold S) (alpha|_S = 0)))
(= (Legendre_fibration) (fibration (fibers_are_Legendrian)))
(= (contact_omorphism) (diffeomorphism_preserving_contact_form))
(= (strict_contactomorphism) (diffeomorphism_preserving_exact_contact_form))
(= (Booth_Wang) (iff (contact_form) (prequantization_line_bundle)))
(= (contact_homology) (Legendrian_homology_via_Chebkanov_Eliashberg_DGA))
(= (Weinstein_conjecture) (exists (Reeb_orbit) (for (closed_contact_manifold))))
(= (Gray_stability) (isotopic_contact_structures_homotopic))
(= (overtwisted_contact_structure) (exists (overtwisted_disk)))
(= (tight_contact_structure) (not (overtwisted)))
(= (h_principle_contact) (classification_overtwisted_via_homotopy))
(= (Lagrangian_foliation) (Legendrian_foliation_in_symplectization))

(|- ((==> (contact_geometry) (symplectic_geometry)) (stv 1.0 0.9)))
(|- ((==> (contact_geometry) (differential_geometry)) (stv 1.0 0.9)))
(|- ((==> (contact_geometry) (topology)) (stv 1.0 0.9)))
(|- ((==> (contact_geometry) (Riemannian_geometry)) (stv 1.0 0.9)))
(|- ((==> (contact_geometry) (dynamical_systems)) (stv 1.0 0.9)))
(|- ((==> (contact_geometry) (morse_theory)) (stv 1.0 0.9)))
