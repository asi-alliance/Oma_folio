; DOMAIN: harmonic-analysis/sobolev-spaces [OPEN, derived 2026-07-31]
(= (sobolev-space $p $k $domain) (Lp-space $p (weak-derivative $k $domain)))
(= (sobolev-norm $p $k $f) (sum (lp-norm $p $f) (lp-norm $p (weak-derivative $k $f))))
(= (sobolev-embedding $k $p $q $n) (=> (and (less $p $n) (less $k (quotient $n $p))) (compact-embedding (sobolev-space $p $k) (Lp-space $q)))
(= (relich-kondrachov $p $k $domain) (compact-embedding (sobolev-space $p $k $domain) (Lp-space $p $domain)))
(= (trace-operator $k $f) (restriction $f (boundary $domain)))
(= (poincare-inequality $p $f $domain) (leq (lp-norm $p $f) (constant $domain) (lp-norm $p (gradient $f))))
(= (sobolev-dual $p $k) (sobolev-space (dual-exponent $p) (negation $k)))
(= (weak-solution $pde $u) (forall $test (satisfied (weak-form $pde $u $test))))
(= (lax-milgram $a $L) (=> (and (coercive $a) (bounded-bilinear $a)) (exists $u (= ($L $u) $a $u))))
(= (friedrichs-inequality $f $domain) (leq (lp-norm 2 $f) (constant $domain) (lp-norm 2 (gradient $f))))
(= (meyer-serrin $p $k $domain) (dense (smooth-functions $domain) (sobolev-space $p $k $domain)))
(= (fractional-sobolev $p $s $domain) (gagliardo-seminorm $p $s $f))
(= (sobolev-multiplication $p $k1 $k2) (=> (greater-eq $k1 $k2) (bounded (multiplication-operator (sobolev-space $p $k1) (sobolev-space $p $k2))))
(= (extension-operator $domain $k $p) (bounded-linear (sobolev-space $p $k $domain) (sobolev-space $p $k (extend $domain))))
(= (difference-quotient-characterization $p $s $f) (equiv (sobolev-space $p $s) (bounded (difference-quotient-norm $p $f))))
