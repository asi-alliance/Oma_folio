(; GENESIS: deformation theory — infinitesimal study of moduli ;)
(Domain: algebraic_geometry/complex_geometry)
(Bridges: algebraic_geometry complex_geometry moduli_space differential_geometry sheaf_theory)
(Survey-basis: Kodaira Spencer Hartshorne Sernesi)

(== (deformation_functor Def_X) (functor Artin_rings Sets (A -> isomorphism_classes_deformations_over_A)))
(= (infinitesimal_deformation) (element H^1(X T_X))
(= (obstruction_space) (H^2(X T_X))
(= (Kodaira_Spencer_map) (map T_e_S -> H^1(X T_X))
(= (first_order_deformation) (class_in H^1(X T_X))
(= (versal_deformation_space) (miniversal_base (hull Def_X))
(= (Kuranishi_map) (map H^1(X T_X) -> H^2(X T_X)))
(= (prorepresentable_functor) (exists (R) (nat_equiv Def_X Hom(Spec_R))))
(= (Schlessinger_criteria) (and (gluing_axiom) (fiber_product_axiom)))
(= (smoothable_deformation) (deformation_over_dual_numbers_extends_to_curve))
(= (T^1_X) (Ext^1(Omega_X O_X))
(= (obstruction_theory) (two_term_complex phi E0 -> E1 controlling_Deformations))
(= (hilbert_scheme) (moduli_of_subschemes (Hilb(P))))
(= (picard_scheme) (moduli_of_line_bundles))
(= (rigid_variety) (= (H^1(X T_X) 0)))
(= (unobstructed_deformation) (= (obstruction_class) 0))
(= (versal_family) (flat_family_over_versal_base))

