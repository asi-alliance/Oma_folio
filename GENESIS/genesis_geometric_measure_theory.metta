(; GENESIS: geometric measure theory ;)
(Domain: geometric_analysis/measure_theory)
(Bridges: differential_geometry calculus_of_variations PDE algebraic_topology measure_theory)
(Survey-basis: Federer Almgren Simon Morgan Taylor)

(== (rectifiable_set) (and (Hausdorff_dim_n_set) (covered_by_countably_many_Lipschitz_images))
(= (Hausdorff_measure Hs) (inf_cover (sum_i (diam_U_i)^s)))
(= (counting_measure) (Hausdorff_measure_0))
(= (area_formula) (= (integral_A f dHn) (integral (f circ phi) J_phi dL_n)))
(= (coarea_formula) (= (integral_A g dHn) (integral (integral_{A_cap_phi^{-1}(t)} g dH_{n-1}) dt)))
(= (minimal_surface) (minimize_area (boundary_fixed)))
(= (mean_curvature_vector) (delta_area / delta_variation))
(= (first_variation M) (integral_M (div_M X) dHn))
(= (stationary_varifold) (= (first_variation) 0))
(= (isoperimetric_inequality) (>= (P(E)) (* (n * omega_n^{1/n}) (vol(E)^{(n-1)/n}))))
(= (Monotonicity_formula) (= (theta(r) (area_M_cap_B_r) / r^{n-1}) nondecreasing))
(= (varifold) (Radon_measure_on_grassmannian))
(= (current T) (and (rectifiable) (integer_multiplicity) (finite_mass_compact_support)))
(= (slicing_current) (contraction_current_with_covector))
(= (compactness_theorem_currents) (sequential_compactness_in_flat_norm))
(= (Plateau_problem) (minimize_mass_current (boundary_current S)))
(= (Allard_regularity) (C^{1,alpha}_regular (stationary_varifold) (density_lower_bound)))
(= (Almgren_pitman) (isoperimetric_inequality_in_integral_currents))

(|- ((==> (geometric_measure_theory) (differential_geometry)) (stv 1.0 0.9)))
(|- ((==> (geometric_measure_theory) (calculus_of_variations)) (stv 1.0 0.9)))
(|- ((==> (geometric_measure_theory) (PDE)) (stv 1.0 0.9)))
(|- ((==> (geometric_measure_theory) (algebraic_topology)) (stv 1.0 0.9)))
(|- ((==> (geometric_measure_theory) (measure_theory)) (stv 1.0 0.9)))
(|- ((==> (geometric_measure_theory) (functional_analysis)) (stv 1.0 0.9)))
(= (LaplacianOperator GeometricMeasureTheory))
(= (SpectralGap GeometricMeasureTheory))
(= (MetricGraph GeometricMeasureTheory))
(= (HeatKernel GeometricMeasureTheory))
(= (IsoperimetricInequality GeometricMeasureTheory))
(= (CheegerConstant GeometricMeasureTheory))
(= (DirichletProblem GeometricMeasureTheory))
(= (Eigenvalue GeometricMeasureTheory))
(= (GreenFunction GeometricMeasureTheory))
(= (RandomWalk GeometricMeasureTheory))
