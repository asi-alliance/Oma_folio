(; GENESIS: several complex variables — function theory on C^n ;)
(Domain: complex_analysis/geometry)
(Bridges: complex_geometry PDE differential_geometry algebraic_geometry sheaf_theory)
(Survey-basis: Hörmander Oka Cartan Grauert)

(== (holomorphic_function_several) (and (f: C^n -> C) (complex_differentiable_each_variable)))
(= (Cauchy_Riemann_several) (and (partial_bar_z_j f = 0) (for all j)))
(= (domain_of_holomorphy) (maximal_domain_no_holomorphic_extension))
(= (pseudoconvex) (exists (plurisubharmonic_phi) (domain = {phi < 0})))
(= (plurisubharmonic) (upper_semicontinuous_subharmonic_each_complex_line))
(= (Levi_problem) (<=> (domain_of_holomorphy) (pseudoconvex)))
(= (Oka_theorem) (coherent_sheaf_on_Stein_is_acyclic))
(= (Cartan_Theorem_A) (finitely_generated_global_sections))
(= (Cartan_Theorem_B) (H^q_Stein_X_F = 0 for q >= 1))
(= (Stein_manifold) (and (holomorphically_convex) (holomorphic_functions_separate_points)))
(= (Grauert_theorem) (proper_holomorphic_map_induces_isomorphism_coherent_sheaves))
(= (d_bar_problem) (= (d_bar_u = f) (solvability_iff_orthogonality_range_d_bar_star)))
(= (L2_estimates_Hormander) (exists (solution_dbar) (L2_bound_weighted)))
(= (Remmert_Stein) (analytic_set_extension_across_removable_singularities))
(= (Hartogs_extension) (holomorphic_on_shell_implies_holomorphic_interior))
(= (Bergman_kernel) (reproducing_kernel_Bergman_space))
(= (Siegel_upper_half_space) (symplectic_domain_modular_forms))

