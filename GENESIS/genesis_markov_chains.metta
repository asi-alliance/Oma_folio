(; GENESIS: Markov chains — discrete state stochastic processes with memoryless transitions ;)
(Domain: probability/stochastic_processes)
(Bridges: probability stochastic_processes queueing_theory information_theory ergodic_theory renewal_theory)
(Survey-basis: Markov Kolmogorov Norris Meyn_Tweedie Levin_Peres)

(== (markov_chain) (and (state_space S) (transition_matrix P) (markov_property P(X_{n+1}|X_n) = P(X_{n+1}|X_0..X_n)))
(= (discrete_time_markov_chain) (DTMC_with_transition_matrix))
(= (continuous_time_markov_chain) (CTMC_with_generator_matrix_Q))
(= (transition_matrix) (stochastic_matrix_rows_sum_to_1))
(= (generator_matrix) (Q_matrix_offdiag_rates_diag_exit_rates))
(= (stationary_distribution) (pi_satisfying_pi_P = pi))
(= (irreducible_markov_chain) (all_states_communicate))
(= (aperiodic_markov_chain) (gcd_return_times_to_state_is_1))
(= (ergodic_markov_chain) (and (irreducible) (aperiodic) (positive_recurrent)))
(= (ergodic_theorem_markov) (lim 1/n sum f(X_k) = E_pi[f]))
(= (mixing_time) (time_to_get_close_to_stationary_distribution))
(= (spectral_gap) (1 - lambda_2_second_largest_eigenvalue))
(= (reversible_markov_chain) (detailed_balance_pi_i P_ij = pi_j P_ji))
(= (Metropolis_Hastings) (reversible_MCMC_for_sampling_target_distribution))
(= (absorbing_markov_chain) (has_absorbing_states_no_exit))
(= (fundamental_matrix) (N = (I - Q)^-1 for_transient_states))
(= (hitting_time) (T_i = min{n: X_n = i}))
(= (recurrent_state) (P(T_i < inf) = 1))
(= (transient_state) (P(T_i < inf) < 1))
(= (Chapman_Kolmogorov) (P^n_ij = sum_k P^m_ik P^(n-m)_kj))
(= (hidden_markov_model) (HMM_with_observable_emissions_hidden_states))
(= (Markov_decision_process) (MDP_states_actions_transitions_rewards))
(= (Foster_Lyapunov) (drift_condition_for_positive_recurrence))

