(; GENESIS: fluid dynamics — Navier-Stokes and continuum motion ;)
(Domain: PDE/applied_mathematics)
(Bridges: PDE differential_geometry dynamical_systems functional_analysis turbulence)
(Survey-basis: Navier Stokes Euler Batchelor Majda)

(== (fluid_flow) (and (velocity_field u) (pressure p) (density rho)))
(= (Euler_equations) (and (= (partial_t u) (+ (* (u dot grad) u) (- (1/rho) (grad p)))) (= (div u) 0)))
(= (Navier_Stokes_equations) (and (= (partial_t u) (+ (* (u dot grad) u) (- (1/rho) (grad p)) (* nu (laplacian u)))) (= (div u) 0)))
(= (Reynolds_number Re) (/ (* rho U L) mu))
(= (incompressible_flow) (= (div u) 0))
(= (compressible_flow) (not (incompressible_flow)))
(= (vorticity omega) (curl u))
(= (Bernoulli_law) (= (+ (* 0.5 rho u^2) p (* rho g h)) constant))
(= (potential_flow) (exists (phi) (and (= u (grad phi)) (laplacian phi 0))))
(= (boundary_layer) (thin_region (no_slip_condition (wall))))
(= (Prandtl_equations) (boundary_layer_approx (Navier_Stokes)))
(= (turbulence) (and (high_Re) (chaotic_flow) (energy_cascade))
(= (Kolmogorov_spectrum) (= (E k) (* C (epsilon^{2/3}) (k^{-5/3}))))
(= (energy_cascade) (transfer_energy_large_to_small_scales))
(= (enstrophy) (integral (* 0.5 (vorticity^2)) dV))
(= (Kelvin_circulation_theorem) (conservation_circulation_barotropic_inviscid))
(= (Helmholtz_decomposition) (= u (+ (grad phi) (curl A))))
(= (Stokes_flow) (low_Re_creeping_flow)
(= (Blasius_solution) (similarity_solution_boundary_layer_flat_plate))

(|- ((==> (fluid_dynamics) (PDE)) (stv 1.0 0.9)))
