(|- ((==> (fluid_dynamics) (dynamical_systems)) (stv 1.0 0.9)))
(|- ((==> (fluid_dynamics) (functional_analysis)) (stv 1.0 0.9)))
(|- ((==> (fluid_dynamics) (turbulence)) (stv 1.0 0.9)))
