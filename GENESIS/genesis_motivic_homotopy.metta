; DOMAIN: algebraic-topology/motivic-homotopy [OPEN, derived 2026-07-31]
(= (A1-homotopy-category $k) (localization (A1-weak-equivalence) (Nisnevich-local-equivalence) (simplicial-presheaves (smooth-schemes $k))))
(= (stable-motivic-category $k) (stabilization (A1-homotopy-category $k) (projective-line $k)))
(= (motivic-sphere $p $q) (suspension-power (motivic-unit) $p $q))
(= (slice-filtration $k $n) (tower (slice-layer $n) (slice-fiber $n)))
(= (morel-connectivity $k $X $i) (=> (less $i 0) (= (A1-homotopy-group $i $X) (zero))))
(= (milnor-witt-K-zero $k) (= (A1-homotopy-group 0 (motivic-sphere 0 0)) (milnor-witt-K-theory $k 0)))
(= (eta-element $k) (element-of (motivic-homotopy-group 1 1 (motivic-sphere 0 0)) (eta $k)))
(= (motivic-cohomology $X $p $q) (hom-set (stable-motivic-category $k) (suspension-spectrum $X) (HZ $q $p)))
(= (representable-K-theory $k) (= (algebraic-K-theory $k) (homotopy-groups (KGL $k))))
(= (representable-cobordism $k) (= (algebraic-cobordism $k) (homotopy-groups (MGL $k))))
(= (motivic-Eilenberg-MacLane $k $q) (EM-object (motivic-sphere 0 0) $q))
(= (real-realization $k) (functor (stable-motivic-category $k) (stable-homotopy-category R)))
(= (complex-realization $k) (functor (stable-motivic-category $k) (stable-homotopy-category C)))
(= (betti-realization $k) (functor (A1-homotopy-category $k) (homotopy-category Spaces)))
(= (eta-not-nilpotent $k) (not (nilpotent (eta $k))))
(= (slice-recovers-motivic-cohomology $n) (= (slice-layer $n) (motivic-Eilenberg-MacLane $k $n)))
