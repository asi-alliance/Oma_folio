(; GENESIS: Morse theory — critical points and topology ;)
(Domain: differential_topology/algebraic_topology)
(Bridges: differential_geometry algebraic_topology dynamical_systems Riemannian_geometry)
(Survey-basis: Milnor Bott Raol_Bott)

(== (Morse_function f) (and (smooth f) (nondegenerate_critical_points f)))
(= (Hessian_index f p) (count_negative_eigenvalues (Hessian f p)))
(= (Morse_index) (Hessian_index f p))
(= (Morse_lemma) (exists (chart_u_p) (= (f x) (- (f p) (sum_i (y_i^2)) (sum_j (z_j^2))))) (index = number_of_i))
(= (Morse_homology) (homology_of (Morse_complex)))
(= (Morse_complex) (chain_complex (critical_points f) (gradient_flow_lines)))
(= (stable_unstable_manifold) (and (= (W^s p) (inflowing_gradient p)) (= (W^u p) (outflowing_gradient p))))
(= (Morse_inequality) (>= (count_critical_points_index_k f) (Betti_number_k)))
(= (handle_attachment) (attach_k_handle (Hessian_index f p) (sublevel_set f p)))
(= (cell_decomposition) (CW_complex (handle_decomposition (Morse_function f))))
(= (Lacunary_principle) (= (sum_k (-1)^k (count_index_k f)) (Euler_characteristic)))
(= (Conley_index) (homotopy_type (isolated_invariant_set (flow))))
(= (Witten_deformation) (perturb_d_by_df (Hodge_theory_via_Morse)))

(|- ((==> (morse_theory) (differential_geometry)) (stv 1.0 0.9)))
(|- ((==> (morse_theory) (algebraic_topology)) (stv 1.0 0.9)))
(|- ((==> (morse_theory) (dynamical_systems)) (stv 1.0 0.9)))
(|- ((==> (morse_theory) (Riemannian_geometry)) (stv 1.0 0.9)))
(|- ((==> (morse_theory) (symplectic_geometry)) (stv 1.0 0.9)))
(|- ((==> (morse_theory) (differential_topology)) (stv 1.0 0.9)))
