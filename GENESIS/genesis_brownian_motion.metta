(; GENESIS: Brownian motion — continuous stochastic process with independent Gaussian increments ;)
(Domain: probability/stochastic_processes)
(Bridges: probability stochastic_processes stochastic_calculus markov_chains PDE martingale_theory)
(Survey-basis: Wiener Einstein Levy Karatzas_Shreve Revuz_Yor)

(== (brownian_motion) (and (B_0=0) (independent_increments) (Gaussian_increments_B_t-B_s~N(0,t-s)) (continuous_paths)))
(= (wiener_process) (standard_brownian_motion))
(= (quadratic_variation) (lim_sum (B_{t_k}-B_{t_{k-1}})^2 = t))
(= (reflection_principle) (P(max_{s<=t} B_s >= a) = 2 P(B_t >= a)))
(= (markov_property_bm) (B_t_given_past = B_t_given_B_s))
(= (strong_markov_property) (markov_at_stopping_times))
(= (blumenthal_zero_one_law) (germ_sigma_algebra_events_prob_0_or_1))
(= (law_of_iterated_logarithm) (limsup B_t/sqrt(2t log log t) = 1))
(= (brownian_bridge) (B_t - t B_1 on [0,1]))
(= (ornstein_uhlenbeck) (OU_process_mean_reverting_Gaussian))
(= (geometric_brownian_motion) (dS = mu S dt + sigma S dW))
(= (ito_lemma) (df(B_t) = fprime dW + (1/2) fprimeprime dt))
(= (martingale_bm) (B_t is martingale with respect to natural filtration))
(= (burkholder_davis_gundy) (E[sup|B|^p] ~ E[<B>_t^{p/2}]))
(= (recurrence_bm) (d-dimensional BM visits every point for d=1,2))
(= (hausdorff_dimension_bm_graph) (dim = 3/2 for 1D BM))
(= (girsanov_theorem) (change_of_measure_for_drift_transformation))
(= (cameron_martin) (translation_in_density_by Cameron-Martin_function))
(= (kolmogorov_extension) (consistent_finite_dim_distributions_define_process))
(= (brownian_local_time) (L_t^a occupation_density_of_BM_at_a))
(= (tanaka_formula) (|B_t-a| decomposition via local_time))

