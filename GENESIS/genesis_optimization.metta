; DOMAIN: optimization/convex-optimization [OPEN, derived 2026-08-01]
(= (convex-set $C) (closed-under-convex-combinations $C))
(= (convex-function $f) (epigraph-convex $f))
(= (subgradient $g $f $x) (sublinear-functional $g $f $x))
(= (lagrangian $L $f $g $lambda) (objective-plus-constraint-penalty $L $f $g $lambda))
(= (kkt-conditions $x $lambda) (stationarity-complementarity-feasibility $x $lambda))
(= (dual-problem $D) (maximize-lagrangian-over-lambda $D))
(= (strong-duality $p $d) (zero-duality-gap $p $d))
(= (slater-condition $f $g) (strictly-feasible-point $f $g))
(= (gradient-descent $x_k) (iterative-negative-gradient $x_k))
(= (proximal-operator $prox $f $x) (argmin-distance-plus-function $prox $f $x))
(= (newton-method $x_k) (iterative-newton-step $x_k))
(= (projected-gradient $x_k $C) (gradient-then-project $x_k $C))
(= (duality-gap $p $d) (primal-minus-dual-objective $p $d))
(= (convex-conjugate $f* $f) (legendre-fenchel-transform $f* $f))
(= (complementarity $x $lambda) (product-zero-constraint-multiplier $x $lambda))
