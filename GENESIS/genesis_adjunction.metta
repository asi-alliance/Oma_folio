; DOMAIN: category-theory/adjunction [OPEN, derived 2026-07-31]
(= (left-adjoint $F $G $C $D) (functor $C $D $F))
(= (right-adjoint $F $G $C $D) (functor $D $C $G))
(= (adjunction $F $G $C $D) (natural-isomorphism (hom-set $D ($F $X) $Y) (hom-set $C $X ($G $Y))))
(= (unit-adjunction $F $G) (natural-transformation identity $G))
(= (counit-adjunction $F $G) (natural-transformation $F identity))
(= (adjunction-unit-counit $F $G) (compose $F unit (compose counit $F)))
(= (triangle-identity-left $F $G $X) (compose ($F (unit $X)) (counit ($F $X))))
(= (triangle-identity-right $F $G $Y) (compose (unit ($G $Y)) ($G (counit $Y))))
(= (adjoint-preserves-limits $G) (preserves-limits $G))
(= (adjoint-preserves-colimits $F) (preserves-colimits $F))
(= (adjoint-preserves-continuous $G) (continuous $G))
(= (free-forgetful-adjunction $F $U) (adjunction $F $U Set Algebra))
(= (adjoint-functor-theorem $F) (=> (and (complete-category $C) (solution-set $F)) (has-left-adjoint $F)))
(= (composition-adjoints $F1 $G1 $F2 $G2) (adjunction (compose $F1 $F2) (compose $G2 $G1)))
(= (adjunction-duality $F $G) (adjunction (opposite $G) (opposite $F)))
(= (reflective-subcategory $C $D $R $I) (and (full-embedding $I) (left-adjoint $R $I)))
