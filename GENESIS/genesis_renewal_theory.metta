(; GENESIS: renewal theory — times between events and counting processes ;)
(Domain: probability/stochastic_processes)
(Bridges: probability stochastic_processes queueing_theory markov_chains reliability_theory)
(Survey-basis: Feller Cox Ross Gallager)

(== (renewal_process) (and (iid_interarrival_times X_n) (S_n = sum X_k) (N_t = max{n: S_n <= t})))
(= (renewal_function m(t)) (E[N_t] (expected_number_of_renewals_by_t)))
(= (renewal_density u(t)) (derivative_of m(t) (sum_of_interarrival_densities)))
(= (renewal_equation) (= m(t) (F(t) + integral_0^t m(t-x) dF(x))))
(= (elementary_renewal_theorem) (= (lim m(t)/t as t->inf) (1/E[X])))
(= (key_renewal_theorem) (= (lim integral_0^t h(t-x) dm(x) (integral h(u) du / E[X]))))
(= (Poisson_process) (renewal_process_with_exponential_interarrival_times))
(= (renewal_reward_theorem) (= (lim R(t)/t (E[reward_per_cycle]/E[cycle_length]))))
(= (delayed_renewal_process) (first_interarrival_different_distribution))
(= (stationary_renewal_process) (equilibrium_renewal_with_delayed_first_arrival_palm))
(= (alternating_renewal_process) (on_off_periods_alternate_renewal_cycles))
(= (defective_renewal_process) (renewal_with_defective_interarrival_distribution))
(= (age_distribution) (distribution_of_A_t = t - S_{N(t)}))
(= (residual_life_distribution) (distribution_of_Y_t = S_{N(t)+1} - t))
(= (inspection_paradox) (length_biased_sampling_increases_observed_interarrival))
(= (large_deviations_renewal) (rate_function_for_renewal_counts))
(= (renewal_arrhythmia) (non_stationary_renewal_with_time_varying_rate))
(= (superposition_of_renewals) (merging_independent_renewal_processes))
(= (Blackwell_theorem) (m(t+h) - m(t) -> h/E[X] for lattice_and_nonlattice))

(|- ((==> (renewal_theory) (probability)) (stv 1.0 0.9)))
(|- ((==> (renewal_theory) (stochastic_processes)) (stv 1.0 0.9)))
(|- ((==> (renewal_theory) (queueing_theory)) (stv 1.0 0.9)))
(|- ((==> (renewal_theory) (markov_chains)) (stv 1.0 0.9)))
(|- ((==> (renewal_theory) (reliability_theory)) (stv 1.0 0.9)))
(|- ((==> (renewal_theory) (large_deviations_theory)) (stv 1.0 0.9)))
