; DOMAIN: functional-analysis/spectral-theory [OPEN, derived 2026-08-01]
(= (spectrum $A $a) (set $lambda (not (invertible (- $a $lambda)))))
(= (spectral-measure $A $a) (projection-valued-measure (spectrum $A $a)))
(= (spectral-theorem-self-adjoint $A $a) (integral (multiply $lambda (spectral-measure $A $a $lambda))))
(= (point-spectrum $A $a) (set $lambda (eigenvalue $a $lambda)))
(= (continuous-spectrum $A $a) (range-dense-but-not-point $a))
(= (residual-spectrum $A $a) (complement (union (point-spectrum $a) (continuous-spectrum $a))))
(= (resolvent-set $A $a) (complement (spectrum $A $a)))
(= (resolvent-operator $A $a $lambda) (inverse (- $a $lambda)))
(= (spectral-radius $A $a) (sup (spectrum $A $a)))
(= (compact-operator $T) (limits-of-finite-rank $T))
(= (fredholm-operator $T) (and (finite-dim-kernel $T) (finite-dim-cokernel $T)))
(= (fredholm-index $T) (- (dimension (kernel $T)) (dimension (cokernel $T))))
(= (trace-class-operator $T) (convergent (sum (singular-values $T))))
(= (hilbert-schmidt-operator $T) (square-integrable (sum (singular-values $T))))
(= (spectral-multiplicity-theory $A $a) (decomposition $a (cyclic-subspaces $a)))
