(; GENESIS: calculus of variations ;)
(Domain: mathematical_analysis/optimization)
(Bridges: differential_geometry symplectic_geometry PDE optimization theoretical_physics)
(Survey-basis: Gelfand-Fomin Tonelli Noether)

(== (action_functional L q) (integral_t0_t1 (L t q (qdot q))))
(= (Euler-Lagrange L) (= (- (d_dt (partial_q L)) (partial_qdot L)) 0))
(= (Hamiltonian H) (- (* p (partial_qdot L)) L))
(= (Hamilton_eq1) (= qdot (partial_p H)))
(= (Hamilton_eq2) (= pdot (- (partial_q H))))
(= (Noether_theorem) (= (d_dt (Noether_charge Q)) 0))
(= (brachistochrone) cycloid)
(= (isoperimetric) (Euler-Lagrange (+ L (* lambda C))))

