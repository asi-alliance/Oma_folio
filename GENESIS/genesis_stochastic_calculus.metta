(; GENESIS: stochastic calculus ;)
(Domain: probability/applied_mathematics)
(Bridges: probability_theory PDE optimal_control functional_analysis martingale_theory)
(Survey-basis: Ito Stratonovich Protter)

(== (semimartingale X) (and (adapted_process X) (= X (+ M A))))
(= (Ito_integral f dW) (limit (sum_i (* (f t_i) (- (W t_i_plus_1) (W t_i))))))
(= (Ito_lemma X) (= (df(t,X_t)) (+ (partial_t f) (* (partial_x f) dX_t) (* 0.5 (partial_xx f) (dX_t_sq))))))
(= (Stratonovich_integral f circ dW) (midpoint_sum))
(= (SDE) (= (dX_t) (+ (* mu t X_t) dt (* sigma t X_t) dW_t))))
(= (Girsanov_theorem) (<=> (absolutely_continuous Q P) (exists (theta) (Radon_Nikodym_derivative))))
(= (Feynman_Kac) (<=> (SDE_expectation) (Parabolic_PDE)))
(= (martingale_representation) (= (local_martingale M) (Ito_integral H dW)))
(= (quadratic_variation X) (limit (sum_i (- (X t_i_plus_1) (X t_i))_sq)))
(= (Burkholder_Davis_Gundy) (<= (E sup M p) (* C_p (E M_var_p_half))))
(= (Doleans_Dade_exp Z) (exp (+ Z (- 0.5 Z_var))))
(= (reflection_principle) (= P(sup W_s ge a) (* 2 P(W_T ge a))))

