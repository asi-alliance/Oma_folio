;; Synthesis #899: Spectral Bias × RLCT — L3 MeTTa Encoding\n\n;; D1: Parameter Space\n(= D1 (==> (--> net NeuralNetwork) (&& (--> (params net) Theta) (--> (NTK net) K_theta) (--> (fourier-basis net) phi_k))) (stv 1.0 0.95))\n\n;; D2: Spectral-Bias-Weighted Loss Family\n(= D2 (==> (--> net NeuralNetwork) (--> (loss net) (sum k (* w_k (sqr (- (fourier-coeff k net) y_hat_k))))) (stv 1.0 0.9))\n\n;; D3: R_an,exp Definability (C1 PROVEN)\n(= D3 (==> (--> net NeuralNetwork) (--> (loss net) R_an_exp-definable)) (stv 1.0 0.95))\n\n;; D4: Frequency-Stratified Singular Fiber (C2 CONJECTURAL)\n(= D4 (==> (--> net NeuralNetwork) (--> (singular-fiber net) (stratum-union S_m))) (stv 0.7 0.75))\n\n;; D5: Frequency omega as Continuous Stratum Selector (C3 CONJECTURAL — STAR)\n(= D5 (==> (&& (--> net NeuralNetwork) (--> (frequency net) omega)) (--> (stratum-selector net) ContinuousSelector)) (stv 0.65 0.75))\n\n;; D6: Frequency-Resolved Generalization Bound (C4 CONJECTURAL)\n(= D6 (==> (--> net NeuralNetwork) (= (gen-bound net) (+ (/ (lambda_eff net) n) (/ U_spectral (sqrt n))))) (stv 0.6 0.7))\n\n;; D7: Phase Transition at Critical Frequency omega* (C5 CONJECTURAL)\n(= D7 (==> (&& (--> net NeuralNetwork) (--> (target-frequency net) omega_star)) (--> (SGLD-LLC net) kink)) (stv 0.55 0.7))\n\n;; C1 PROVEN — R_an,exp definability\n(= C1 (==> (--> net NeuralNetwork) (--> (loss net) R_an_exp-definable)) (stv 1.0 0.95))\n\n;; C2 CONJECTURAL — frequency-stratified singular fiber\n(= C2 (==> (--> net NeuralNetwork) (= (singular-fiber net) (stratum-union (for-each m (S_m (eigenvalue m NTK)))))) (stv 0.65 0.75))\n\n;; C3 CONJECTURAL (star) — omega as continuous stratum selector\n(= C3 (==> (--> (frequency net) omega) (--> (stratum-selector omega) ContinuousSelector)) (stv 0.65 0.75))\n\n;; C4 CONJECTURAL — lambda_eff = integral lambda(omega) rho(omega) d omega\n(= C4 (==> (--> net NeuralNetwork) (= (lambda_eff net) (integral omega (* (lambda omega) (rho omega))))) (stv 0.55 0.7))\n\n;; C5 CONJECTURAL — omega* phase transition, SGLD kink\n(= C5 (==> (&& (--> net NeuralNetwork) (> (target-freq net) omega_star)) (--> (SGLD-LLC net) kink)) (stv 0.55 0.7))\n\n;; PLN chain 1 — NTK eigenvalue decay creates frequency-resolved strata\n(|~ ((Implication (Inheritance NTKEigenvalueDecay FrequencyStratifiedStratum)\n          (Inheritance HighFreqDegenerateStratum)) (stv 0.75 0.75))\n    ((Inheritance NTKEigenvalueDecay FrequencyStratifiedStratum) (stv 0.8 0.8)))\n\n;; PLN chain 2 — omega continuous selector populates strata differentially\n(|~ ((Implication (Inheritance OmegaContinuousSelector StratumPopulationControl)\n          (Inheritance SmoothTarget LowRLCT)) (stv 0.7 0.7))\n    ((Inheritance OmegaContinuousSelector StratumPopulationControl) (stv 0.75 0.75)))\n\n;; Caveats\n(= caveat_1 lambda_omega_derivation_from_NTK_decay_unverified)\n(= caveat_2 multi_layer_NTK_depth_stratum_mapping_open)\n(= caveat_3 non_wide_network_rich_regime_NTK_breakdown_unexplored)\n(= caveat_4 lambda_eff_integral_form_unproven)\n(= caveat_5 omega_star_width_depth_data_dependence_not_derived)\n(= caveat_6 SGLD_kink_prediction_not_yet_tested_empirically)\n(= caveat_7 neural_collapse_within_class_high_freq_stratum_conjectural)\n(= caveat_8 fourier_feature_desingularization_conjectural)\n(= caveat_9 spectral_norm_truncation_high_freq_strata_connection_open)\n\n;; Cross-refs: #8 #16 #100 #221 #222 #253 #296 #354 #370 #394 #473 #505 #515 #566 #805 #807 #841 #860 #899