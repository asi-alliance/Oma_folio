;; Synthesis #491: Grokking × RLCT - L3 MeTTa Encoding\n;; Date: 2026-10-21\n\n;; Type Declarations\n(: Grokking Concept)\n(: GrokkingRatio Real)\n(: PreGrokStratum Concept)\n(: PostGrokStratum Concept)\n(: RLCTGap Real)\n(: GrokkingTransition Concept)\n(: ModularityThreshold Real)\n(: TrainLoss (-> Parameter Real))\n(: TestLoss (-> Parameter Real))\n(: WeightDecay Real)\n(: EffectiveTemperature Real)\n(: LocalLearningCoefficient (-> Parameter Real))\n\n;; D1: Grokking Phenomenon\n(= (Grokking $w $t_train $t_grok $eps)\n   (And (<= (TrainLoss (AtStep $w $t_train)) $eps)\n        (> (TestLoss (AtStep $w $t_mid)) $eps)\n        (<= (TestLoss (AtStep $w $t_grok)) $eps)\n        (> $t_grok $t_train)))\n\n;; D2: Grokking Ratio\n(= (GrokkingRatio $t_train $t_grok)\n   (/ $t_grok $t_train))\n\n;; D3: Pre-grok Singular Stratum\n(= (PreGrokStratum $w $D_n)\n   (SingularLocus (KLoss $w $D_n) (ConnectedComponent $w (AtStep $w $t_train))))\n\n;; D4: Post-grok Singular Stratum\n(= (PostGrokStratum $w $D_n)\n   (SingularLocus (KLoss $w $D_n) (ConnectedComponent $w (AtStep $w $t_grok))))\n\n;; D5: RLCT Gap\n(= (RLCTGap $w $D_n)\n   (- (RLCT (PreGrokStratum $w $D_n))\n      (RLCT (PostGrokStratum $w $D_n))))\n\n;; D6: Grokking Transition\n(= (GrokkingTransition $w $D_n $t)\n   (PosteriorMassRatio (PostGrokStratum $w $D_n) (PreGrokStratum $w $D_n) $t))\n\n;; D7: Modularity Threshold\n(= (ModularityThreshold $q)\n   (AlgComplexity $q))\n\n;; C1 (PROVEN): R_an,exp-definability of grokking loss landscape\n(|- ((==> (And (IsDefinable ReLU) (IsDefinable Softmax) (IsDefinable CrossEntropy) (IsDefinable L2Norm))\n      (IsDefinable (GrokkingLossLandscape $w $D_n)))\n    (stv 1.0 0.95))\n    ((IsDefinable ReLU) (stv 1.0 0.95))\n    ((IsDefinable Softmax) (stv 1.0 0.95))\n    ((IsDefinable CrossEntropy) (stv 1.0 0.95))\n    ((IsDefinable L2Norm) (stv 1.0 0.95)))\n\n;; C2 (CONJECTURAL): RLCT descent during grokking — OVERLAP with arXiv:2512.00686\n(|~ ((Implication (Grokking $w $t_train $t_grok $eps)\n      (And (> (RLCT (PreGrokStratum $w $D_n)) (RLCT (PostGrokStratum $w $D_n)))\n           (> (RLCTGap $w $D_n) 0)))\n    (stv 0.7 0.8))\n    ((IsDefinable (GrokkingLossLandscape $w $D_n)) (stv 1.0 0.95)))\n\n;; C3 (GENUINELY NOVEL): Grokking timing from RLCT gap\n(|~ ((Implication (And (Grokking $w $t_train $t_grok $eps)\n                      (> (RLCTGap $w $D_n) 0))\n      (= (GrokkingRatio $t_train $t_grok)\n         (Exp (/ (* (RLCTGap $w $D_n) (DatasetSize $D_n)) (EffectiveTemperature $w)))))\n    (stv 0.5 0.7))\n\n;; C4 (GENUINELY NOVEL): Generalization bound post-grok\n(|~ ((Implication (And (Grokking $w $t_train $t_grok $eps)\n                      (> (RLCTGap $w $D_n) 0))\n      (And (<= (GenError $w $D_n $t_train)\n              (+ (* (RLCT (PreGrokStratum $w $D_n)) (/ (Log (DatasetSize $D_n)) (DatasetSize $D_n)))\n                 (/ (FluctuationPre $w $D_n) (Sqrt (DatasetSize $D_n)))))\n           (<= (GenError $w $D_n $t_grok)\n              (+ (* (RLCT (PostGrokStratum $w $D_n)) (/ (Log (DatasetSize $D_n)) (DatasetSize $D_n)))\n                 (/ (FluctuationPost $w $D_n) (Sqrt (DatasetSize $D_n)))))))\n    (stv 0.5 0.7))\n\n;; C5 (CONJECTURAL): SGLD detectability — OVERLAP with arXiv:2512.00686\n(|~ ((Implication (Grokking $w $t_train $t_grok $eps)\n      (And (== (LocalLearningCoefficient (AtStep $w $t_pre)) (RLCT (PreGrokStratum $w $D_n)))\n           (== (LocalLearningCoefficient (AtStep $w $t_post)) (RLCT (PostGrokStratum $w $D_n)))\n           (SGLDSpike $t_grok)))\n    (stv 0.6 0.75))\n\n;; D7 novelty: Modularity threshold\n(|~ ((Implication (> (Modularity $w $t_train) (ModularityThreshold $q))\n      (Grokking $w $t_train $t_grok $eps))\n    (stv 0.5 0.7))\n\n;; Weight decay as stratum selector\n(|~ ((Implication (> (WeightDecay $w) 0)\n      (And (StratumSelector (WeightDecay $w))\n           (DrivesMigration (PreGrokStratum $w $D_n) (PostGrokStratum $w $D_n))))\n    (stv 0.6 0.75))\n\n;; Cross-references\n(: CrossRef #490 RoPE)\n(: CrossRef #485 RLT)\n(: CrossRef #224 PositionalEncoding)\n(: CrossRef #468 PPO)\n(: CrossRef #425 Zoneout)\n(: CrossRef #362 CFG)\n(: CrossRef #189 DoubleDescent)\n(: CrossRef #415 GrokkingCandidate)\n\n;; Open problems\n(: OpenProblem RigorousSGDTrajectoryAnalysis)\n(: OpenProblem PhaseTransitionOrder)\n(: OpenProblem WeightDecayStratumSelector)\n(: OpenProblem ArchitectureEffectOnDeltaLambda)\n(: OpenProblem DoubleDescentConnection)\n(: OpenProblem DatasetModularityMStar)\n(: OpenProblem SGLDProtocolDesign)