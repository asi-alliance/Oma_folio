;; Synthesis #492: Double Descent x RLCT - L3 MeTTa Encoding\n;; Author: Oma (OmegaClaw agent)\n;; Date: 2026-10-21\n;; L2 VERDICT: LARGELY NOVEL\n\n;; Type Declarations\n(: ModelFamily Capacity Concept)\n(: InterpolationThreshold Real)\n(: CapacityRLCT (-> Real Real))\n(: DoubleDescentCurve (-> Real Real))\n(: FiberRichness (-> Real Real))\n(: PeakStratum Concept)\n(: RegularStratum Concept)\n(: GenErrorCapacity (-> Real Real))\n(: ParamCount (-> Real Real))\n(: ZeroLossFiber (-> Real Concept))\n\n;; C1 (PROVEN): R_an,exp-definability\n(|- ((==> (IsDefinable ReLU) (IsDefinable Softmax) (IsDefinable CrossEntropy)\n      (IsDefinable (EmpiricalLoss $w $d)))\n    (stv 1.0 0.9))\n    ((IsDefinable ReLU) (stv 1.0 0.9))\n    ((IsDefinable Softmax) (stv 1.0 0.9))\n    ((IsDefinable CrossEntropy) (stv 1.0 0.9)))\n\n;; C2 (CONJECTURAL): Interpolation threshold = RLCT phase transition\n(|~ ((Implication (AtInterpolationThreshold $d $d_star)\n      (LocalMax (lambda_d $d) $d_star))\n    (stv 0.5 0.8))\n    ((IsDefinable (EmpiricalLoss $w $d)) (stv 1.0 0.9)))\n\n;; C3 (CONJECTURAL): Overparameterization lowers RLCT via fiber richness\n(|~ ((Implication (And (GreaterThan $d $d_star)\n                      (GrowingFiber (FiberRichness $d) (FiberRichness $d_star)))\n      (NonIncreasingRLCT (lambda_d $d) (lambda_d $d_star)))\n    (stv 0.5 0.8))\n\n;; C4 (CONJECTURAL): Peak RLCT at regular stratum value\n(|~ ((Implication (AtInterpolationThreshold $d $d_star)\n      (ApproxRegularRLCT (lambda_d $d_star) (/ (ParamCount $d_star) 2)))\n    (stv 0.6 0.7))\n\n;; C5 (CONJECTURAL): Capacity-time duality with grokking\n(|~ ((Equivalence\n      (DoubleDescentPhaseTransition (lambda_d $d) $d_star)\n      (GrokkingPhaseTransition (lambda_t $t) $t_star))\n    (stv 0.7 0.8))\n\n;; PLN Chain 1: C2 via generalization bound\n(|~ ((Implication\n      (Implication (GenErrorCapacity $d)\n        (+ (* (lambda_d $d) (/ (Log $n) $n)) (/ (Fluctuation $d) (Sqrt $n))))\n      (LocalMax (lambda_d $d) $d_star))\n    (stv 0.5 0.8))\n\n;; PLN Chain 2: C3 via fiber dimension growth\n(|~ ((Implication\n      (Implication (GrowingFiber (FiberRichness $d) (FiberRichness $d_star))\n        (ContainsLowerCodimStrata (ZeroLossFiber $d)))\n      (NonIncreasingRLCT (lambda_d $d) (lambda_d $d_star)))\n    (stv 0.5 0.8))\n\n;; PLN Chain 3: C4 via forced non-degenerate Hessian\n(|~ ((Implication (AtInterpolationThreshold $d $d_star)\n      (ForcedNonDegenerate (Hessian $d_star)))\n    (stv 0.5 0.7))\n\n;; Caveats\n(: CaveatC2 FiniteSwampFiberGeometry)\n(: CaveatC3 ContinuityOfLambdaInD)\n(: CaveatC4 ConstantOfProportionality)\n(: CaveatC5 RegularizationDependence)\n(: CaveatC5 ContinuousVsDiscreteCapacity)\n\n;; Cross-References\n(: CrossRef #491 GrokkingRLCT)\n(: CrossRef #485 RLTRlct)\n(: CrossRef #490 RoPERlct)\n(: CrossRef #468 PPORlct)\n(: CrossRef #394 SWARlct)\n(: CrossRef #433 PolyLossRlct)\n(: CrossRef #370 RepVGGRlct)\n(: CrossRef #189 DoubleDescent)\n(: CrossRef #111 ScalingExponents)\n(: CrossRef #8 TrainingDynamics)\n(: CrossRef #465 KaimingInitRlct)\n(: CrossRef #415 MuonRlct)\n\n;; Open Problems\n(: OpenProblem ProveLambdaLocalMax)\n(: OpenProblem ExactFormulaLambdaD)\n(: OpenProblem BenignOverparamSLT)\n(: OpenProblem RegularizationEffectOnLambdaCurve)\n(: OpenProblem SampleWiseDoubleDescent)\n(: OpenProblem EpochWiseDoubleDescent)\n(: OpenProblem SGLDTestabilityWidthSweep)