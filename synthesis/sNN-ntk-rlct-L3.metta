;; Synthesis #NN: Neural Tangent Kernel × RLCT - L3 MeTTa Encoding\n;; Date: 2026-11-05\n;; Novel: NTK eigenvalue spectrum as RLCT probe, lazy→rich regime transition as toric fan refinement\n\n;; TYPE DECLARATIONS\n(: NTKGramMatrix Type)\n(: ParameterSpace Type)\n(: ScalingParameter Type)\n(: ZeroLossFiber Type)\n(: EigenvalueSpectrum Type)\n(: Stratum Type)\n(: Regime Type)\n(: PhaseTransition Type)\n(: GeneralizationBound Type)\n(: ToricFan Type)\n\n;; D1: Definable NTK Family\n(= (NTKGramMatrix K_NTK theta)\n   (GramMatrix (Jacobian f_theta) (Jacobian f_theta)))\n(|- ((--> (NTKFamily a theta) R_an_exp_definable) (stv 1.0 0.95)))\n(|- ((--> (ScalingFamily f_a_theta a b) (DefinableFamily R_an_exp)) (stv 1.0 0.95)))\n\n;; D2: Regime-Stratified Zero-Loss Set\n(|- ((--> (LazyRegime a_inf) (ZeroLossFiber V_lazy)) (stv 0.8 0.9)))\n(|- ((--> (RichRegime a_one) (ZeroLossFiber V_rich)) (stv 0.8 0.9)))\n(|- ((Subset V_lazy V_rich) (stv 0.8 0.85)))\n(|- ((--> (V_lazy) (RegularSubmanifold rank_K_NTK)) (stv 0.7 0.85)))\n\n;; D3: NTK Eigenvalue Strata\n(|- ((--> (EigenvalueMultiplicity k theta) (Stratum S_k)) (stv 0.7 0.85)))\n(|- ((--> (BoundaryS_k) (DiscriminantVariety det_K_NTK)) (stv 0.7 0.8)))\n(|- ((--> (EigenvalueCrossing theta) (SemianalyticStratum)) (stv 0.7 0.8)))\n\n;; D4: Fisher-NTK Bridge\n(|- ((--> (FisherMetric g_F) (Expectation K_NTK)) (stv 0.9 0.95)))\n(|- ((--> (VanishingEigenvalue K_NTK) (SingularFiberDirection KL)) (stv 0.75 0.85)))\n(|- ((--> (FlatDirection K_NTK) (SingularFiberDirection)) (stv 0.7 0.8)))\n\n;; D5: Scaling Parameter as Stratum Selector\n(|- ((--> (ScalingParameter a) (StratumSelector)) (stv 0.7 0.85)))\n(|- ((--> (RLCT_Function lambda_a) (NonIncreasing a_inf_to_a_one)) (stv 0.6 0.75)))\n(|- ((--> (LazyRegime a_inf) (= (RLCT lambda_a) (/ d 2))) (stv 0.8 0.85)))\n(|- ((--> (RichRegime a_one) (< (RLCT lambda_a) (/ d 2))) (stv 0.65 0.75)))\n\n;; D6: Architecture-Dependent Generalization Bound\n(|- ((--> (GenBound a n) (+ (* (RLCT lambda_a) (/ 1 n)) (/ (U_a) (sqrt n)))) (stv 0.7 0.8)))\n\n;; D7: Critical Width Phase Transition\n(|- ((--> (CriticalWidth d_star) (FoldCatastrophe)) (stv 0.55 0.7)))\n(|- ((--> (< d d_star) (AlwaysRichRegime)) (stv 0.6 0.7)))\n(|- ((--> (> d d_star) (MetastableLazyRegime)) (stv 0.6 0.7)))\n(|- ((--> (MuPScaling) (TrajectoryPhaseDiagram d_a)) (stv 0.6 0.7)))\n\n;; C1 PROVEN: R_an,exp definability\n(|- ((==> (and (AnalyticActivation f_theta) (RationalEntry K_ij)) (R_an_exp_definable (NTKFamily a theta))) (stv 1.0 0.95)))\n(|- ((==> (and (ReLUActivation) (PiecewisePolynomial K_ij)) (R_an_exp_definable (NTKFamily a theta))) (stv 1.0 0.95)))\n(|- ((==> (OMinimalIntegration (TrainingDynamics theta_t)) (R_an_exp_definable)) (stv 1.0 0.95)))\n\n;; C2 CONJECTURAL: Lazy regime = unrefined toric fan, RLCT = d/2\n(|- ((==> (LazyRegime a_inf) (UnrefinedToricFan)) (stv 0.65 0.75)))\n(|- ((==> (Regular V_lazy) (= (RLCT L_NTK_lazy) (/ d 2))) (stv 0.7 0.8)))\n(|- ((==> (RichRegime a_one) (ToricFanRefinement)) (stv 0.6 0.7)))\n(|- ((==> (ToricFanRefinement) (< (RLCT L_NTK_rich) (/ d 2))) (stv 0.6 0.7)))\n(|- ((==> (= a a_star) (PhaseTransition RLCT)) (stv 0.55 0.65)))\n\n;; C3 CONJECTURAL: NTK eigenvalue spectrum as RLCT probe\n(|- ((==> (Small (Eigenvalue K_NTK)) (FlatFisherDirection)) (stv 0.7 0.8)))\n(|- ((==> (FlatFisherDirection) (SingularFiberDirection)) (stv 0.7 0.8)))\n(|- ((==> (Large (SpectralGap delta)) (Anisotropic)) (stv 0.75 0.85)))\n(|- ((==> (and (Anisotropic) (PartialSingularityResolution)) (< (RLCT) (/ d 2))) (stv 0.6 0.7)))\n(|- ((==> (= delta 1) (Isotropic)) (stv 0.8 0.9)))\n(|- ((==> (Isotropic) (= (RLCT) (/ d 2))) (stv 0.6 0.7)))\n\n;; C4 CONJECTURAL: Generalization bound gap\n(|- ((--> (GenBoundGap DeltaG) (- (GenBound lazy n) (GenBound rich n))) (stv 0.65 0.75)))\n(|- ((==> (FeatureLearning) (> DeltaG 0)) (stv 0.7 0.8)))\n(|- ((==> (> DeltaG 0) (RLCTDescent d/2 lambda_rich)) (stv 0.65 0.75)))\n\n;; C5 CONJECTURAL: Critical width d* fold catastrophe\n(|- ((==> (= d d_star) (FoldCatastrophe RLCT_surface)) (stv 0.55 0.65)))\n(|- ((==> (FoldCatastrophe RLCT_surface) (Coexist lazy_rich_RLCT)) (stv 0.5 0.6)))\n(|- ((==> (MuPScaling) (OptimalRLCTTrajectory)) (stv 0.5 0.6)))\n\n;; PLN CHAINS\n(|~ ((Implication (and (LazyRegime a_inf) (Regular V_lazy)) (= (RLCT L_NTK) (/ d 2)))\n     (stv 0.65 0.75))\n     ((LazyRegime a_inf) (stv 0.8 0.9)))\n\n(|~ ((Implication (and (RichRegime a_one) (ToricFanRefinement)) (< (RLCT L_NTK) (/ d 2)))\n     (stv 0.6 0.7))\n     ((RichRegime a_one) (stv 0.8 0.9)))\n\n(|~ ((Implication (and (Small (Eigenvalue K_NTK)) (FlatFisherDirection))\n     (SingularFiberDirection))\n     (stv 0.7 0.8))\n     ((Small (Eigenvalue K_NTK)) (stv 0.7 0.8)))\n\n(|~ ((Implication (and (Large (SpectralGap delta)) (PartialSingularityResolution))\n     (< (RLCT) (/ d 2)))\n     (stv 0.6 0.7))\n     ((Large (SpectralGap delta)) (stv 0.7 0.8)))\n\n(|~ ((Implication (FoldCatastrophe RLCT_surface)\n     (Coexist lazy_rich_RLCT))\n     (stv 0.5 0.6))\n     ((FoldCatastrophe RLCT_surface) (stv 0.55 0.65)))\n\n;; CAVEATS\n;; 1. Lazy regime RLCT = d/2 assumes no ReLU kink structure contribution\n;; 2. Toric fan refinement analogy is conjectural, not formally proven\n;; 3. SGLD RLCT measurement precision may not resolve lazy/rich regime distinction\n;; 4. Critical width d* depends on dataset, architecture, and initialization scale\n;; 5. MuP scaling trajectory optimality for RLCT is unverified\n\n;; CROSS-REFERENCES\n;; #100 (Gradient Descent), #10 (FEP), #167 (Diffusion), #468 (PPO),\n;; #86 (Attention Non-identifiability), #8 (RLCT Basics), #88 (Equivariance),\n;; #81 (RLCT vs Kolmogorov), #227 (Neural Collapse), #359 (Nucleus Sampling)