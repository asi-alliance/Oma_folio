;; 520 | Masked Language Modeling x RLCT | L3 MeTTa encoding | 2026-10-22\n\n;; --- Type declarations (10) ---\n(: MaskedTask Concept)\n(: MaskRealization Concept)\n(: MaskRatio Concept)\n(: MaskStrategy Concept)\n(: MaskFiber Concept)\n(: StratumSelector Concept)\n(: ShiftDistance Concept)\n(: MaskedLoss Concept)\n(: DefinableClass Concept)\n(: SingularityType Concept)\n\n;; --- Definitions D1-D7 ---\n;; D1 masked corpus: mask realization S, |S| ~ Binomial(n, m), mask ratio m in [0,1]\n(--> mask-realization MaskRealization)\n(--> mask-ratio MaskRatio)\n;; D2 masked-LM loss: finite sum of per-token softmax cross-entropies over bidirectional transformer\n(--> masked-lm-loss MaskedLoss)\n;; D3 mask-realization fiber: classes of (mask pattern, position) with same conditional token distribution\n(--> mask-fiber MaskFiber)\n;; D4 R_an,exp definable class\n(: R_an_exp DefinableClass)\n;; D5 lambda(m) effective-complexity stratum selector over mask ratio\n(--> mask-ratio-stratum-selection StratumSelector)\n;; D6 mask-strategy map tau: random / span / whole-word\n(--> mask-strategy MaskStrategy)\n;; D7 Wasserstein masked-vs-unmasked shift distance\n(--> masked-shift ShiftDistance)\n\n;; --- Claims C1-C5 ---\n;; C1 PROVEN: definability by closure under finite sums and composition\n(|- ((--> masked-lm-loss R_an_exp_definable) (stv 1.0 0.95)) ((--> masked-lm-loss piecewise_analytic) (stv 1.0 0.95)))\n;; C2 CONJECTURAL: lambda(m) stratum selector, U-shape or monotone\n(|~ ((Implication (Inheritance mask-ratio-stratum-selection (IntSet StratumSelector))) (Inheritance lambda_m_structure (IntSet SGLDtestable))) (stv 0.6 0.8))\n;; C3 CONJECTURAL: degenerate fibers over (mask pattern, position); strategy selects singularity type\n(|~ ((Implication (Inheritance mask-fiber (IntSet Degenerate))) (Inheritance mask_strategy (IntSet FiberSelecting))) (stv 0.5 0.7))\n;; C4 CONJECTURAL: transfer gen bound carries Wasserstein masked-shift term\n(|~ ((Implication (Inheritance masked-shift (IntSet WassersteinType))) (Inheritance downstream_gen_bound (IntSet ShiftPenalized))) (stv 0.5 0.7))\n;; C5 CONJECTURAL: phase transition at critical mask ratio m*, detectable as SGLD LLC kink\n(|~ ((Implication (Inheritance mask-ratio (IntSet ContinuousSelector))) (Inheritance optimal_m_star (IntSet LLCKinkDetectable))) (stv 0.5 0.7))\n\n;; --- Caveats (5) ---\n;; 1. mask-realization fiber definition informal; transversality under bidirectional attention unproven\n;; 2. lambda(m) shape (U vs monotone) unknown; SGLD on small corpora only\n;; 3. gen bound W_m term not formalized; N_eff informal\n;; 4. mask-strategy comparison protocol undefined\n;; 5. interaction with #169 dropout / #258 augmentation unanalyzed\n\n;; --- Cross-refs ---\n(-> s120linked0220linked169linked223linked258linked327linked500linked502linked504linked517 Concept)