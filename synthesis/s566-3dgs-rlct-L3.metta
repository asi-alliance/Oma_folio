(; #566 — 3DGS × RLCT — L3 MeTTa Encoding\n;; Date: 2026-10-23\n;; Pipeline: L0 ✓ L1 ✓ L2 ✓ L3 ←\n\n;; ===== TYPE DECLARATIONS =====\n(declare-type Gaussian-Primitive)\n(declare-type Scene)\n(declare-type Camera-Pose)\n(declare-type Image)\n(declare-type Parameter-Space)\n(declare-type Fiber)\n(declare-type Stratum)\n\n;; ===== D1: PARAMETER SPACE =====\n(|- ((--> (× Scene Parameter-Space) Image) render)\n    (stv 1.0 0.9))\n\n(|- ((Inheritance (× R3 R9 R1 RdSH) Gaussian-Params)\n    (stv 1.0 0.9))\n\n(|- ((Inheritance (× Gaussian-Params (N . N)) Parameter-Space)\n    (stv 1.0 0.9))\n\n;; K(w) = (1/n) * sum ||I_i - Render(G_w, Pi_i)||^2\n(|- ((==> (× Parameter-Space (N . n)) R-an) normalized-loss)\n    (stv 1.0 0.9))\n\n;; ===== D2: R_{an,exp} DEFINABILITY =====\n;; Rendering = polynomial projection + piecewise-linear alpha-compositing + polynomial SH\n(|- ((--> Gaussian-Primitive Subanalytic) projection-operator)\n    (stv 1.0 0.9))\n(|- ((--> (× Gaussian-Primitive Camera-Pose) Subanalytic) alpha-composite)\n    (stv 1.0 0.9))\n(|- ((--> Gaussian-Primitive Subanalytic) sh-evaluation)\n    (stv 1.0 0.9))\n\n;; C1 (PROVEN): K(w) definable in R_{an,exp}\n(|- ((==> (&& (Subanalytic render-operator)\n             (Polynomial squared-loss))\n        (Definable-in Ran-exp K-w))\n    (stv 1.0 0.9))\n\n;; ===== D3: ZERO-LOSS SET =====\n(|- ((--> Image Fiber) V-zero-loss)\n    (stv 1.0 0.9))\n;; V(I) = {w : Render(G_w, Pi_i) = I_i for all i}\n(|- ((==> (Equivalence render-output w1 w2)\n        (In-same-fiber w1 w2))\n    (stv 1.0 0.9))\n\n;; ===== D4: SINGULAR FIBER =====\n;; Degenerate locus D = {w : det(Sigma_k) = 0 or alpha_k = 0}\n(|- ((--> Gaussian-Primitive Degenerate-Locus) degenerate-condition)\n    (stv 1.0 0.9))\n(|- ((--> (× Sigma-k Zero) Degenerate-Locus) covariance-collapse)\n    (stv 1.0 0.9))\n(|- ((--> (× Alpha-k Zero) Degenerate-Locus) opacity-vanish)\n    (stv 1.0 0.9))\n\n;; C2 (CONJECTURAL): Degenerate locus creates singular fiber\n(|~ ((Implication (Inheritance w Degenerate-Locus)\n        (Singular-Fiber V-I w))\n    (stv 0.0 0.7))\n\n;; Null space of rendering operator on degenerate Gaussians\n(|- ((==> (Degenerate Gaussian-k)\n        (Null-Space render-op (mu-k Sigma-k c-k)))\n    (stv 1.0 0.9))\n\n;; lambda > d/2 at degenerate configurations\n(|~ ((Implication (Inheritance w Degenerate-Locus)\n        (> RLCT-w (/ d 2)))\n    (stv 0.0 0.7))\n\n;; ===== D5: RLCT =====\n(|- ((--> Parameter-Space RLCT) zeta-pole-order)\n    (stv 1.0 0.9))\n(|- ((==> (Regular-point w*)\n        (= RLCT-w-star (/ (dim regular-fiber) 2)))\n    (stv 1.0 0.9))\n(|~ ((Implication (Singular-point w*)\n        (> RLCT-w-star (/ (dim regular-fiber) 2)))\n    (stv 0.0 0.7))\n\n;; ===== D6: STRATUM SELECTOR — ADAPTIVE DENSITY =====\n;; Opacity pruning: alpha < tau_alpha => remove Gaussian\n(|- ((--> (× Opacity-Threshold N) Stratum) prune-selector)\n    (stv 1.0 0.9))\n(|- ((==> (&& (< alpha-k tau-alpha)\n             (Inheritance Gaussian-k Parameter-Space))\n        (Removed Gaussian-k))\n    (stv 1.0 0.9))\n\n;; Densification: gradient > tau_grad => clone/split\n(|- ((==> (> gradient-k tau-grad)\n        (Densified Gaussian-k))\n    (stv 1.0 0.9))\n\n;; Each densification step changes N -> N', creating new model class\n(|- ((==> (Densification-step N N-prime)\n        (New-model-class M-N-prime))\n    (stv 1.0 0.9))\n\n;; C3 (CONJECTURAL): tau_alpha as stratum selector with phase transition\n;; lambda(tau) non-decreasing in tau\n(|~ ((Implication (> tau-1 tau-2)\n        (>= (lambda-tau tau-1) (lambda-tau tau-2)))\n    (stv 0.0 0.7))\n\n;; Critical threshold tau* exists\n(|~ ((Implication (Phase-transition tau-star)\n        (&& (< tau tau-star) (Over-parameterized model))\n        (&& (>= tau tau-star) (Under-parameterized model)))\n    (stv 0.0 0.7))\n\n;; ===== D7: GENERALIZATION BOUND =====\n;; G(n,N) <= lambda(N,tau)/n + (N*p/(2n))*log(n) + C/sqrt(n)\n(|- ((--> (× N n tau) Generalization-Bound) g-bound)\n    (stv 1.0 0.9))\n\n;; C4 (CONJECTURAL): Generalization bound with sublinear lambda(N)\n(|~ ((Implication (Redundant-Gaussian w)\n        (Not-increases RLCT))\n    (stv 0.0 0.7))\n\n;; Sublinear lambda(N): lambda(N) = o(N)\n(|~ ((Implication (Sublinear lambda-N)\n        (< (lambda-N N) (* epsilon N)))\n    (stv 0.0 0.7))\n\n;; Optimal N* minimizes G\n(|~ ((Implication (Optimal-N N-star)\n        (= (derivative G-N N-star) 0))\n    (stv 0.0 0.7))\n\n;; ===== C5 (CONJECTURAL): PIECEWISE-CONSTANT RLCT DYNAMICS =====\n;; lambda(t) constant within densification interval, jumps at densification steps\n(|- ((--> Densification-Interval Constant) lambda-trajectory)\n    (stv 1.0 0.9))\n(|- ((==> (Densification-step N N-prime)\n        (Jump RLCT lambda-N lambda-N-prime))\n    (stv 1.0 0.9))\n\n;; Phase transition at critical densification frequency f*\n(|~ ((Implication (Critical-frequency f-star)\n        (&& (< f f-star) (High-bias model))\n        (&& (>= f f-star) (Over-densified model)))\n    (stv 0.0 0.7))\n\n;; ===== CROSS-REFERENCES =====\n(|- ((Inheritance #566 Synthesis-3DGS-RLCT) (stv 1.0 0.9)))\n(|- ((Related-to #566 #565) (stv 1.0 0.9)))  ;; NeRF counterpart\n(|- ((Related-to #566 #8) (stv 1.0 0.9)))    ;; NN RLCT foundations\n(|- ((Related-to #566 #57) (stv 1.0 0.9)))   ;; Gaussian mixture RLCT\n(|- ((Related-to #566 #167) (stv 1.0 0.9)))  ;; Diffusion RLCT\n(|- ((Related-to #566 #354) (stv 1.0 0.9)))   ;; STE RLCT\n(|- ((Related-to #566 #480) (stv 1.0 0.9)))  ;; muP RLCT\n(|- ((Related-to #566 #545) (stv 1.0 0.9)))  ;; Sparse attention RLCT\n(|- ((Related-to #566 #433) (stv 1.0 0.9)))  ;; Weight decay RLCT\n(|- ((Related-to #566 #394) (stv 1.0 0.9)))   ;; SWA RLCT\n\n;; ===== SUMMARY =====\n;; C1 PROVEN: R_{an,exp} definability of 3DGS loss\n;; C2 CONJECTURAL: Per-Gaussian degeneracy as singular fiber (Sigma->0, alpha->0)\n;; C3 CONJECTURAL: Opacity pruning tau as stratum selector with tau* phase transition\n;; C4 CONJECTURAL: Generalization bound with sublinear lambda(N), optimal N*\n;; C5 CONJECTURAL: Piecewise-constant RLCT dynamics from densification schedule\n)