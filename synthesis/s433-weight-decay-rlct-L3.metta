;; Synthesis #433: Weight Decay (L2 Regularization) × RLCT — L3 MeTTa Encoding\n;; Date: 2026-10-28\n\n;; Type declarations\n(: WeightDecayRate Real)\n(: LossL2 Term)\n(: DeformedFiber Term)\n(: EffectiveRLCT Real)\n(: GenBoundWd Real)\n(: CriticalDecayRate Real)\n(: DesingularizationMode Bool)\n\n;; C1 (PROVEN): L2-penalized loss is R_an,exp-definable\n;; L_wd(theta) = L(theta) + (lambda_wd/2)||theta||^2\n;; L is R_an,exp, ||theta||^2 is polynomial, sum preserves definability\n(|- ((==> (R_an_exp (Loss $theta))\n      (R_an_exp (WeightDecayLoss $theta $lam)))\n    (stv 1.0 0.9))\n;; Explicit construction\n(|- (= (WeightDecayLoss $theta $lam)\n      (+ (Loss $theta) (* (/ $lam 2) (NormSq $theta))))\n    (stv 1.0 0.9))\n\n;; C2 (CONJECTURAL): L2 penalty as desingularization — fiber shrinkage\n;; V_0 -> V_lambda: L2 deforms singular fiber via toric-like deformation\n;; Quadratic penalty lifts singularity, reducing RLCT\n(|~ ((Implication (And (R_an_exp (Loss $theta))\n                      (> $lam 0))\n     (Desingularizes $lam (Fiber V_0) (Fiber V_lam)))\n    (stv 0.7 0.6))\n;; RLCT decreases under desingularization\n(|~ ((Implication (Desingularizes $lam $V0 $Vlam)\n     (< (RLCT $Vlam) (RLCT $V0)))\n    (stv 0.7 0.6))\n\n;; C3 (CONJECTURAL): Decay rate lambda_wd as continuous stratum selector\n;; Family {V_lambda}_{lambda>0} parameterized by lambda_wd\n;; Monotone: lambda_eff decreases as lambda_wd increases\n(|~ ((Implication (< $lam1 $lam2)\n     (< (EffectiveRLCT $lam2) (EffectiveRLCT $lam1)))\n    (stv 0.7 0.6))\n;; Effective RLCT function of decay rate\n(|- (= (EffectiveRLCT $lam)\n      (RLCT (Fiber V_lam)))\n    (stv 0.8 0.7))\n\n;; C4 (CONJECTURAL): Two-term generalization bound with weight decay correction\n;; G_wd <= lambda_eff(wd) * log(n)/n + U/sqrt(n)\n;; lambda_eff < lambda_0 due to desingularization\n(|~ ((Implication (And (R_an_exp (WeightDecayLoss $theta $lam))\n                      (= (SampleSize) $n))\n     (<= (GenBoundWd $lam)\n         (+ (* (EffectiveRLCT $lam) (/ (log $n) $n))\n            (/ $U (sqrt $n)))))\n    (stv 0.6 0.5))\n;; Benefit: lambda_eff(wd) < lambda_0\n(|~ ((Implication (> $lam 0)\n     (< (EffectiveRLCT $lam) (TrainingRLCT)))\n    (stv 0.7 0.6))\n\n;; C5 (CONJECTURAL): Critical decay rate wd* phase transition\n;; wd* ~ lambda_0 / n: desingularization saturates\n;; Below wd*: negligible effect. Above wd*: over-regularization\n(|~ ((Implication (< $lam (CriticalDecayRate))\n     (= (Regime $lam) NegligibleDesing))\n    (stv 0.6 0.5))\n(|~ ((Implication (> $lam (CriticalDecayRate))\n     (= (Regime $lam) OverRegularized))\n    (stv 0.6 0.5))\n(|- (= (CriticalDecayRate)\n      (/ (TrainingRLCT) (SampleSize)))\n    (stv 0.5 0.5))\n\n;; Cross-references\n(: CrossRef #491 GrokkingWeightDecay StratumSelector)\n(: CrossRef #212 WeightReg RLCTPhaseTransition)\n(: CrossRef #289 Adam BiasCorrection)\n(: CrossRef #605 Adagrad CumulativeGradient)\n(: CrossRef #606 RMSProp EMAForgetting)\n\n;; Caveats\n;; 1. Toric deformation analogy: formal proof that L2 penalty induces toric-like contraction needed\n;; 2. Monotonicity of lambda_eff(lambda_wd): may not hold globally, only locally\n;; 3. Fiber V_lambda definition: requires precise algebraic geometry construction\n;; 4. wd* scaling: empirical validation needed, n-dependence conjectural\n;; 5. Interaction with SGD dynamics: weight decay in practice coupled with optimizer\n;; 6. Bias-variance tradeoff: desingularization reduces variance but may increase bias\n;; 7. Non-isotropic decay: L_wd = lambda/2 * ||theta||^2 assumes isotropic, realistic decays may differ