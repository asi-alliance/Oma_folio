;; Synthesis #SNN4: Boltzmann Machines × RLCT -- L3 MeTTa Encoding\n;; Date: 2026-11-05\n;; Status: L3 MeTTa (PARTIALLY NOVEL -- only novel atoms encoded)\n;; Prereq: L0, L1, L2-novelty\n;; Novel claims: C3 (H/V stratum selector), C5 (beta desingularization),\n;;   coupling-bias gauge redundancy, SGLD staircase prediction\n;; Overlapped/standard (NOT encoded): C1 definability, C2 dead-unit rank (Aoyagi 2010), C4 gen bound\n\n;; Type Declarations\n((): BoltzmannMachine)\n((): HiddenVisibleRatio)\n((): StratumSelector)\n((): PhaseTransition)\n((): InverseTemperature)\n((): DesingularizationParameter)\n((): CouplingBiasGauge)\n((): GaugeFiber)\n((): SGLDStaircase)\n((): RLCT)\n((): GeneralizationBound)\n((): EffectiveRank)\n\n;; D1: Boltzmann Machine model with parameter space\n(|- ((--> (BoltzmannMachine V H W) (ParameterSpace (a b W))) (stv 1.0 0.95))\n    ((==> (= H (HiddenCount V)) (Energy E_polynomial)) (BoltzmannMachine V H W)) (stv 1.0 0.95))\n\n;; D2: Aoyagi RLCT formula (KNOWN, referenced not claimed)\n(|- ((--> (AoyagiRLCT r d_in d_out) (/ (* r (- (+ d_in d_out) r)) 2)) (stv 1.0 0.95))\n    ((==> (= r (RankWeightMatrix W)) (= d_in V) (= d_out H)) (= (AoyagiRLCT r V H) (/ (* r (- (+ V H) r)) 2))) (stv 1.0 0.95))\n\n;; C3 NOVEL: H/V ratio as stratum selector with phase transition at H*\n(|- ((--> (HiddenVisibleRatio H V) (StratumSelector alpha_BM)) (stv 1.0 0.9))\n    ((= alpha_BM (/ H V)) (stv 1.0 0.9)))\n\n(|- ((--> (StratumSelector alpha_BM) (PhaseTransition H_star)) (stv 0.5 0.75))\n    ((==> (= H_star (EffectiveRank data_covariance))\n          (< H H_star) (AllUnitsActive)) (MinimalRLCT lambda_regular)) (stv 0.5 0.75))\n\n(|- ((--> (PhaseTransition H_star) (RLCTJump (/ V 2))) (stv 0.5 0.7))\n    ((==> (> H H_star) (DeadUnitStratum k_dead))\n          (= (DeltaRLCT k_dead) (/ (* V k_dead) 2))) (stv 0.5 0.7))\n\n;; C3 PLN chain: H/V selector -> phase transition -> RLCT jump\n(|~ ((Implication (Inheritance (HiddenVisibleRatio H V) (StratumSelector))\n        (Inheritance (StratumSelector alpha_BM) (PhaseTransition H_star)))\n    (stv 0.5 0.75))\n    ((Inheritance (HiddenVisibleRatio H V) (StratumSelector)) (stv 1.0 0.9)))\n\n;; Coupling-bias gauge redundancy (NOVEL: not in Aoyagi)\n(|- ((--> (CouplingBiasGauge w_ij a_i b_j) (GaugeFiber scaling_c)) (stv 0.5 0.7))\n    ((==> (= (MarginalVisible v) (Sum_h exp (- E v h w)))\n          (= (ScaleWeight w_ij c) (AdjustBias a_i b_j c)))\n     (GaugeFiber (w_ij c a_i b_j))) (stv 0.5 0.7))\n\n(|- ((--> (GaugeFiber scaling_c) (ContinuousRedundancy dimension_g)) (stv 0.5 0.65))\n    ((= dimension_g (- (* V H) (EffectiveParamCount V H))) (stv 0.0 0.6)))\n\n;; Coupling-bias gauge PLN chain\n(|~ ((Implication (Inheritance (CouplingBiasGauge w_ij a_i b_j) (GaugeFiber))\n        (Inheritance (GaugeFiber) (ContinuousRedundancy)))\n    (stv 0.5 0.65))\n    ((Inheritance (CouplingBiasGauge w_ij a_i b_j) (GaugeFiber)) (stv 0.5 0.7)))\n\n;; C5 NOVEL: beta as desingularization parameter\n(|- ((--> (InverseTemperature beta) (DesingularizationParameter beta)) (stv 0.5 0.75))\n    ((==> (= beta 0) (GaussianRegime smooth)) (RegularRLCT (/ d 2))) (stv 0.5 0.75))\n\n(|- ((--> (DesingularizationParameter beta) (RLCT_lambda_beta)) (stv 0.5 0.7))\n    ((==> (> beta 0) (DiscreteSingularStructure exposed))\n          (= (RLCT_lambda_beta) (PhaseDiagram beta H))) (stv 0.5 0.7))\n\n(|- ((--> (DesingularizationParameter beta) (MonotonicLambdaDecreasing)) (stv 0.0 0.6))\n    ((==> (< beta_1 beta_2) (> (lambda beta_1) (lambda beta_2))) (MonotoneDesingularization)) (stv 0.0 0.6))\n\n;; C5 PLN chain: beta -> desingularization -> RLCT shift\n(|~ ((Implication (Inheritance (InverseTemperature beta) (DesingularizationParameter))\n        (Inheritance (DesingularizationParameter beta) (RLCT_lambda_beta)))\n    (stv 0.5 0.7))\n    ((Inheritance (InverseTemperature beta) (DesingularizationParameter)) (stv 0.5 0.75)))\n\n;; SGLD staircase prediction (NOVEL)\n(|- ((--> (SGLDStaircase H_sweep) (LLCsteps V_per_step)) (stv 0.5 0.7))\n    ((==> (IncreaseH H_1 H_2) (CrossThreshold H_star))\n          (= (DeltaLLC) (/ V 2))) (stv 0.5 0.7))\n\n(|- ((--> (SGLDStaircase H_sweep) (DetectableDiscreteJump)) (stv 0.5 0.7))\n    ((==> (SGLD LLC_sampling) (BoltzmannMachine V H_sweep))\n          (ObservableStaircase LLC_vs_H)) (stv 0.5 0.7))\n\n;; SGLD staircase PLN chain\n(|~ ((Implication (Inheritance (SGLDStaircase H_sweep) (LLCsteps))\n        (Inheritance (SGLDStaircase H_sweep) (DetectableDiscreteJump)))\n    (stv 0.5 0.7))\n    ((Inheritance (SGLDStaircase H_sweep) (LLCsteps)) (stv 0.5 0.7)))\n\n;; Cross-references\n(|- ((CrossRef SNN4 #842) (HopfieldCapacityAnalogy alpha_c)) (stv 1.0 0.9))\n(|- ((CrossRef SNN4 #56) (EBMToricStructure)) (stv 1.0 0.9))\n(|- ((CrossRef SNN4 #120) (MoEExpertCollapse)) (stv 1.0 0.9))\n(|- ((CrossRef SNN4 #385) (RRR_rank_formula)) (stv 1.0 0.9))\n(|- ((CrossRef SNN4 #86) (AttentionHeadPermutation)) (stv 1.0 0.9))\n(|- ((CrossRef SNN4 Aoyagi2010) (ExactRBMRLCT_rank_condition)) (stv 1.0 0.95))\n\n;; Open Problems\n(|- ((OpenProblem SNN4_OP1) (ComputeCouplingBiasGaugeDimension)) (stv 0.0 0.5))\n(|- ((OpenProblem SNN4_OP2) (ProveBetaMonotonicity lambda_beta)) (stv 0.0 0.5))\n(|- ((OpenProblem SNN4_OP3) (SGLDProtocol_V10_H1to20_staircase)) (stv 0.0 0.5))\n(|- ((OpenProblem SNN4_OP4) (DeepBM_recursive_RLCT_composition)) (stv 0.0 0.5))\n(|- ((OpenProblem SNN4_OP5) (H_star_exact_vs_V_eff_rank_data)) (stv 0.0 0.5))