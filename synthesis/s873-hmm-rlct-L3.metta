;; MeTTa encoding for #873: HMM × RLCT\n;; Atoms D1-D7, Claims C1-C5\n\n;; D1: Parameter space\n(= (HMM-parameter-space $K $M)\n   (Theta (A (RowStochastic $K)) (B (EmissionMatrix $K $M)) (pi (Simplex $K))))\n\n(= (effective-dim $K $M)\n   (- (+ (* $K $K) (* $K $M)) 1))\n\n(= (permutation-action $sigma $K)\n   (RelabelStates $sigma $K))\n\n;; D2: HMM Log-likelihood\n(= (HMM-loglikelihood $O $A $B $pi)\n   (Log (SumOver $z (PathProbability $z $O $A $B $pi))))\n\n(= (PathProbability $z $O $A $B $pi)\n   (* (Emission $B $z_1 $O_1) (Initial $pi $z_1)\n      (Product t=2..T (* (Transition $A $z_{t-1} $z_t) (Emission $B $z_t $O_t)))))\n\n(= (ForwardRecursion $t $i $O $A $B)\n   (* (Emission $B $i $O_t)\n      (SumOver $j (* (ForwardRecursion (- $t 1) $j $O $A $B) (Transition $A $j $i)))))\n\n;; C1 (PROVEN): R_an,exp definability\n(|- ((==> (HMM-likelihood $O $theta) (R_an_exp-definable)) (stv 1.0 0.95))\n    ((ForwardRecursion-composition-analytic) (stv 1.0 0.95))\n    ((LogSumExp-analytic) (stv 1.0 0.95))\n    ((Emission-family-definable) (stv 1.0 0.95)))\n\n;; D4: Three-stratum singular fiber\n(= (HMM-singular-fiber $theta)\n   (Union (Permutation-stratum $theta)\n          (Transition-degeneracy-stratum $theta)\n          (Emission-collision-stratum $theta)))\n\n;; (a) Permutation stratum\n(= (Permutation-stratum $theta)\n   (SetOf (sigma-dot-theta $sigma $theta) : (sigma in S_K)))\n\n(|- ((--> (Permutation-stratum $theta) (RLCT-contribution 0)) (stv 1.0 0.9))\n    ((Discrete-symmetry-zero-RLCT) (stv 1.0 0.9)))\n\n;; (b) Transition degeneracy stratum\n(= (Transition-degeneracy-stratum $theta)\n   (SetOf $theta : (or (RankDeficient (Transition-matrix $theta))\n                       (AbsorbingState $theta $i)\n                       (Disconnected-components $theta))))\n\n(= (absorbing-flat-dim $i $K)\n   (- $K 1))\n\n(|- ((--> (AbsorbingState $theta $i) (FlatDirection (outgoing-transitions $i))) (stv 1.0 0.9))\n    ((Absorbed-state-likelihood-factorizes) (stv 1.0 0.9)))\n\n(|- ((--> (Disconnected-components $theta $c) (FlatDirection (unused-class-transitions))) (stv 1.0 0.9))\n    ((Unused-class-likelihood-independent) (stv 1.0 0.9)))\n\n;; (c) Emission collision stratum\n(= (Emission-collision-stratum $theta)\n   (SetOf $theta : (exists $i $j (!= $i $j) (= (Emission $B $i) (Emission $B $j)))))\n\n(|- ((--> (Emission-collision $theta $i $j) (Observationally-indistinguishable $i $j)) (stv 1.0 0.9))\n    ((Identical-emission-same-likelihood) (stv 1.0 0.9)))\n\n;; C2 (CONJECTURAL): Three-stratum RLCT decomposition\n(|- ((==> (HMM-singular-fiber $theta)\n          (= (RLCT-HMM $theta)\n             (+ (* lambda_emit $K_eff)\n                (lambda_trans $A)\n                lambda_absorb))) (stv 0.5 0.7))\n    ((Permutation-RLCT-zero) (stv 1.0 0.9))\n    ((Transition-graph-topology-term) (stv 0.5 0.7))\n    ((Emission-collision-RLCT) (stv 0.5 0.7)))\n\n;; D5: K as temporal-dynamic stratum selector\n(= (K-selector-regime $K $K_star)\n   (cond ((< $K $K_star) (state-merging $K $K_star))\n         ((= $K $K_star) (optimal $K $K_star))\n         ((> $K $K_star) (state-splitting $K $K_star))))\n\n(= (lambda-K-scaling $K $K_star)\n   (+ (* lambda_emit (min $K $K_star))\n      (* lambda_collision (max 0 (- $K $K_star)))\n      (lambda_merge (max 0 (- $K_star $K)))\n      (lambda_trans (A-of-K $K))))\n\n;; C3 (CONJECTURAL): K controls transition graph topology\n(|- ((==> (state-merging $K $K_star)\n          (CoarseGrained-transition-graph $A $K $K_star)) (stv 0.5 0.7))\n    ((Merging-creates-graph-singularity) (stv 0.5 0.7)))\n\n(|- ((==> (state-splitting $K $K_star)\n          (Emission-collision-redundant-states $K $K_star)) (stv 0.5 0.7))\n    ((Splitting-creates-collision-stratum) (stv 0.5 0.7)))\n\n;; D6: Generalization bound\n(= (HMM-gen-bound $K $n $K_star)\n   (+ (* (lambda-K-scaling $K $K_star) (/ (log $n) (* 2 $n)))\n      (/ (U-transition-boundary $K) (sqrt $n))\n      (B-state-mismatch $K $K_star)))\n\n(= (B-state-mismatch $K $K_star)\n   (cond ((< $K $K_star) (KL-divergence (true-distribution $K_star) (approx-distribution $K)))\n         ((= $K $K_star) 0)\n         ((> $K $K_star) 0)))\n\n;; C4 (CONJECTURAL): Gen bound with state-mismatch bias\n(|- ((==> (HMM-gen-bound $K $n $K_star)\n          (Phase-transition-at $K $K_star)) (stv 0.5 0.7))\n    ((Bias-discontinuous-derivative-at-K-star) (stv 0.5 0.7))\n    ((Variance-increases-for-K>K-star) (stv 0.5 0.7)))\n\n;; D7: Phase transition at K*\n(= (LLC-profile $K $K_star)\n   (cond ((< $K $K_star) (sub-linear $K))\n         ((= $K $K_star) (canonical-RLCT $K_star))\n         ((> $K $K_star) (super-linear $K))))\n\n;; C5 (CONJECTURAL): Phase transition detectable via SGLD\n(|- ((==> (SGLD-on-HMM $K) (LLC-profile $K $K_star)) (stv 0.5 0.7))\n    ((Forward-backward-gradient-computable) (stv 1.0 0.9))\n    ((Kink-at-K-star-detectable) (stv 0.5 0.7)))\n\n;; Cross-references\n(HMM-x-RLCT cross-ref #872 #556 #434 #843 #529 #410 #100 #266 #864)\n\n;; Open problems\n(open-problem HMM-RLCT-exact-transition-matrix-rank)\n(open-problem Baum-Welch-singular-stratum-convergence)\n(open-problem SGLD-forward-backward-gradient-stability)\n(open-problem S_K-quotient-temporal-vs-spatial)\n(open-problem Gaussian-vs-discrete-emission-RLCT)\n(open-problem HMM-infinite-K-limit)\n(open-problem HMM-vs-SSM-discrete-continuous-latent)