;; #518 | Gradient Clipping x RLCT | L3 MeTTa ENCODING | 2026-10-22
(= (clipped-update-map $w $lr $T $g) (let* ( $norm (norm2 $g) $s (min 1.0 (div $T $norm)) ) (sgdw $w $lr (scale $s $g))))
(: clipped-update-map : -> Atom)
(= (saturation-stratum $w $T $g) (if (> (norm2 $g) $T) S2 S1))
(: saturation-stratum : -> Atom)
(: B_T BoundarySet)
(: S1 SubanalyticStratum)
(: S2 SubanalyticStratum)
(: PhiT PiecewiseSubanalyticMap)
(: FiberT StratumLockedFiber)
(: LambdaT EffectiveRLCT)
(: TSelector StratumSelector)
(: GBoundT GeneralizationBound)
(= (GBoundT $lambdaT $nEff $UT) (plus (div $lambdaT $nEff) (div $UT (sqrt $nEff))))
(|- ((--> (× analyticLoss gradientNormLevelSet) subanalyticStrata) (stv 1.0 0.9)) ((--> (× analyticLoss clipBoundary) analyticLevelSet) (stv 1.0 0.9)))
(|- ((==> (--> (× PhiT clipBoundaryCrossing) singularFiber)) (--> PhiT lowerComplexitySampling)) (stv 0.5 0.7))
(|- ((==> (--> (× S2 highCurvatureDirection) suppression)) (--> clippedSGD flatterMinima)) (stv 0.5 0.65))
(|- ((==> (--> (× clipThresholdSelection) implicitLambdaSelection)) (--> clippedSGD lowerRLCTMinima)) (stv 0.5 0.7))
(|- ((==> (--> (× clippedSGD matchedTrainLoss)) lowerMeanLLC)) (stv 0.5 0.75))
