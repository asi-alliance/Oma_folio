;; Synthesis #876: Teacher Forcing x RLCT - L3 MeTTa encoding\n;; Date: 2026-11-09 | C1 proven, C2-C5 conjectural | Distinct from #382\n\n;; Type declarations\n(: TeacherForced Concept)\n(: FreeRunning Concept)\n(: AutoregressiveModel Concept)\n(: ExposureBias Concept)\n(: SingularityGap Concept)\n(: CoveragePenalty Concept)\n(: SequenceLength Concept)\n(: StratumSelector Concept)\n(: RecursiveJacobian Concept)\n(: PhaseTransition Concept)\n(: LearningCoefficient Concept)\n\n;; D atoms\n(= D1 (--> ((-->* TeacherForced FreeRunning) AutoregressiveModel) (&& (--> train TeacherForced) (--> eval FreeRunning))) (stv 1.0 0.95))\n(= D2 (--> (--> train TeacherForced) (==> (ce_loss (time-step i (product t (prediction i))))) (stv 1.0 0.95))\n(= D3 (--> (x FreeRunning) (==> (ce_loss (recursive-step i (product t (prediction t (i - 1))))) (stv 1.0 0.95))\n(= D4 (--> (ce_loss FreeRunning) (x (RecursiveJacobian off-diagonal temporal-coupling))) (stv 0.8 0.9))\n(= D5 (--> (tmax-decision-boundary D_delta) (&& (t times-recursive) (= argmax-boundary))) (stv 0.85 0.9))\n(= D6 (--> ExposureBias (> delta (- lambda_FR lambda_TF)) (= delta lambda_FR_minus_lambda_TF)) (stv 0.75 0.85))\n(= D7 (--> (SingularityGap lambda_max) (--> (i (singularities (i+1))))) (stv 0.7 0.85))\n\n;; C1 PROVEN - R_an,exp definability\n(= C1 (stv 1.0 0.95))\n;; C2 CONJECTURAL - Structural singularity mismatch\n(= C2 (--> RecursiveJacobian AdditionalSingularity) (stv 0.65 0.75))\n;; C3 CONJECTURAL - delta-lambda as formal exposure bias invariant\n(= C3 (--> (X ExposureBias SingularityGap) (= delta lambda_FR_minus_lambda_TF)) (stv 0.65 0.75))\n;; C4 CONJECTURAL - Generalization bound with coverage penalty\n(= C4 (--> (X GenBound FreeRunning) (<= (+ (/ (* lambda_FR 2) (log n)) (CoveragePenalty + CoveragePenalty))) (stv 0.6 0.7))\n;; C5 CONJECTURAL - Sequence length T as stratum selector, phase transition at T-star\n(= C5 (--> (X SequenceLength StratumSelector) (= T-star (pow n (/ 1 lambda_TF))) (stv 0.6 0.75))\n\n;; PLN chain 1 - Recursive Jacobian creates additional singular directions\n(|~ ((Implication (Inheritance RecursiveJacobian OffDiagonalTemporalCoupling) (Inheritance FreeRunning AdditionalSingularity)) (stv 0.8 0.8)) ((Inheritance RecursiveJacobian OffDiagonalTemporalCoupling) (stv 0.75 0.85)))\n\n;; PLN chain 2 - delta-lambda gap drives coverage penalty\n(|~ ((Implication (Inheritance FreeRunning HigherRLCT) (Inheritance ExposureBias CoveragePenaltyOrigin)) (stv 0.8 0.8)) ((Inheritance FreeRunning SingularityState) (stv 0.7 0.8)))\n\n;; PLN chain 3 - T as stratum selector phase transition\n(|~ ((Implication (Inheritance (increase T) (PhaseTransition TStarPass)) (Inheritance StratumSelector TAsPhaseTransition)) (stv 0.8 0.8)) ((Inheritance RecursiveJacobian TimeCoupledIncreasing) (stv 0.7 0.85)))\n\n;; Caveats\n(= caveat_1 recursive_jacobian_off_diagonal_formal_connection_to_resolution_of_singularities_unproven)\n(= caveat_2 coverage_penalty_formal_structure_unknown_no_SGLD_run_yet)\n(= caveat_3 T_star_scaling_exponent_1_over_lambda_TF_derived_from_singular_analysis_not_empirically_verified)\n(= caveat_4 A_1_fold_singularity_at_argmax_boundaries_argued_but_not_related_to_Eckart-Young_framework)\n(= caveat_5 multi_step_error_accumulation_in_FR_loss_exceeds_computation_cost_limit)\n\n;; Cross-refs: #8 #16 #73 #265 #342 #385 #491 #511 #513 #538 #540 #567 #653 #874