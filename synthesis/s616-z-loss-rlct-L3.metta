# Synthesis #616: Z-Loss x RLCT - L3 MeTTa Encoding\n### Date: 2026-10-25\n### Status: L3 MeTTa Encoding\n\n---\n\n# MeTTa Type Declarations\n\n(: Param Type)\n(: Logit Type)\n(: NormZ Type)\n(: LogZ Type)\n(: Loss Type)\n(: Fiber Type)\n(: RLCT Type)\n(: ClassCount Type)\n(: GaugeFreedom Type)\n(: StratumSelector Type)\n(: Alpha Type)\n\n# MeTTa Atom Declarations\n\n;; D1: Loss function decomposition\n(= (z-loss $w $alpha $x $y)\n   (+ (ce-loss $w $x $y)\n      (* $alpha (sq (log-z $w $x)))))\n\n(= (ce-loss $w $x $y)\n   (+ (- (logit $w $y $x))\n      (log-z $w $x)))\n\n(= (log-z $w $x)\n   (log (sum ($k) (exp (logit $w $k $x)))))\n\n;; D2: R_an,exp-definability (C1 PROVEN)\n(= (definable-z-loss $w $alpha $x $y)\n   (And (Definable (logit $w $k $x))\n        (Definable (exp (logit $w $k $x)))\n        (Definable (log (sum ($k) (exp (logit $w $k $x)))))))\n\n;; D3: Singular set V_0(alpha)\n(= (singular-set $alpha)\n   (SetOf ($w) (= (z-loss $w $alpha $x $y) (inf-z-loss $alpha))))\n\n;; D4: Fiber structure - CE vs z-loss competition\n(= (ce-fiber $w)\n   (SetOf ($v) (= (log-z $w $x) $v)))\n\n(= (balance-point $alpha $w)\n   (= (softmax-prob $w $y $x)\n      (/ 1 (+ 1 (* 2 $alpha (log-z $w $x))))))\n\n;; D5: Alpha-parameterized family\n(= (loss-family $alpha)\n   (FamilyOf ($w) (z-loss $w $alpha $x $y)))\n\n;; D6: Alpha as stratum selector\n(= (stratum-ce $alpha) (And (Less $alpha alpha-star) (= (rlct $alpha) rlct-ce)))\n(= (stratum-uniform $alpha) (And (Greater $alpha alpha-star) (= (rlct $alpha) rlct-uniform)))\n\n;; D7: RLCT via zeta function\n(= (zeta $z $alpha)\n   (Integral ($w) (* (exp (- (z-loss $w $alpha $x $y)))\n                     (pow (det (fisher $w)) $z))))\n\n(= (rlct $alpha)\n   (LargestPole (zeta $z $alpha)))\n\n# Claim Encoding\n\n;; C1 (PROVEN): R_an,exp-definability of z-loss\n(|- ((==> (And (Definable (logit $w $k $x))\n               (Definable (exp (logit $w $k $x)))\n               (Definable (log (sum ($k) (exp (logit $w $k $x))))))\n          (R_an_exp (z-loss $w $alpha $x $y)))\n     (stv 1.0 0.95))\n\n;; C2 (CONJECTURAL): Gauge freedom in 2-class bias-only case\n(|- ((==> (And (= (ClassCount 2) (BiasOnly $w))\n               (GaugeFreedom (logit-sum $w)))\n          (= (rlct $alpha) (rlct ce-loss)))\n     (stv 0.8 0.8))\n\n;; C2b: Gauge freedom allows z-loss = 0 without CE penalty\n(|- ((==> (And (= (ClassCount 2) (BiasOnly $w))\n               (= (logit-sum $w) (gauge-opt $w)))\n          (= (log-z $w $x) 0))\n     (stv 0.8 0.85))\n\n;; C3 (CONJECTURAL): K-dependent bifurcation - gauge breaks for K >= 3\n(|- ((==> (GreaterEq (ClassCount $k) 3)\n          (Not (GaugeFreedom (logit-sum $w))))\n     (stv 0.7 0.8))\n\n(|- ((==> (And (GreaterEq (ClassCount $k) 3)\n               (Not (GaugeFreedom (logit-sum $w))))\n          (Greater (rlct $alpha) (rlct ce-loss)))\n     (stv 0.6 0.7))\n\n;; C4 (CONJECTURAL): Generalization bound with K-dependent bifurcation\n(|~ ((Implication (ZLossRegularizer $alpha)\n                  (GenBound (+ (/ (rlct $alpha) (log n))\n                              (/ $U (sqrt n)))))\n     (stv 0.5 0.7))\n\n;; C5 (CONJECTURAL): Phase transition at alpha*\n(|- ((==> (And (Less $alpha alpha-star))\n          (= (rlct $alpha) (rlct ce-loss)))\n     (stv 0.6 0.7))\n\n(|- ((==> (Greater $alpha alpha-star)\n          (= (rlct $alpha) (rlct uniform-loss)))\n     (stv 0.6 0.7))\n\n# PLN Chains\n\n;; PLN: Gauge freedom => z-loss free => RLCT unchanged (K=2)\n(|~ ((Implication (And (GaugeFreedom (logit-sum $w))\n                        (= (ClassCount 2)))\n                  (= (rlct $alpha) (rlct ce-loss)))\n     (stv 0.8 0.8))\n\n;; PLN: Gauge breaks => z-loss constrains fiber => RLCT increases (K>=3)\n(|~ ((Implication (And (Not (GaugeFreedom (logit-sum $w)))\n                        (GreaterEq (ClassCount $k) 3))\n                  (Greater (rlct $alpha) (rlct ce-loss)))\n     (stv 0.6 0.7))\n\n# Cross-References\n\n;; Links to related syntheses\n(: #8 ce-loss Type)\n(: #224 temperature-scaling Type)\n(: #282 weight-decay Type)\n(: #323 label-smoothing Type)\n(: #548 mixup Type)\n\n---\n## L3 COMPLETE. Next: L4 summary + L5 catalog entry.