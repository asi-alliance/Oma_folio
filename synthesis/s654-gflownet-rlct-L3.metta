;; Synthesis #654 - GFlowNet x RLCT L3 MeTTa Encoding\n;; Date: 2026-10-26\n;; ============================================\n\n;; TYPE DECLARATIONS\n(: ParameterSpace Type)\n(: ForwardPolicy (-> ParameterSpace State Real))\n(: BackwardPolicy (-> ParameterSpace State Real))\n(: RewardFn (-> State Real))\n(: PartitionFn (-> ParameterSpace Real))\n(: Trajectory (-> State (List State) State))\n(: TBLoss (-> Trajectory ParameterSpace Real))\n(: TempParam Real)\n\n;; D1: Parameter Space\n(= (param_space w) (ParameterSpace w))\n(= (forward_policy PF w) (ForwardPolicy w))\n(= (backward_policy PB w) (BackwardPolicy w))\n\n;; D2: Partition Function Z(w) = integral exp(f(x;w)) dx\n(= (partition_fn Z w) (PartitionFn w))\n(|- ((==> (ForwardPolicy $w $x) (Exp (SublinearNet $x $w))) (stv 1.0 0.95))\n    ((--> (sublinear_net $x $w) analytic_in_w) (stv 1.0 0.9)))\n\n;; D3: Trajectory Balance Loss\n(= (tb_loss L_TB tau w) (TBLoss tau w))\n(|- ((==> (TBLoss $tau $w) (Square (Sub (Log (TrajPartition $tau)) (Log (PartitionFn $w)) (SumEdgeLog $tau $w) (LogReward $tau))) (stv 1.0 0.9))\n    ((--> (tb_equation $tau $w) balanced) (stv 1.0 0.9)))\n\n;; D4: TB Singular Manifold - zero set of L_TB\n(= (tb_manifold V_TB w) {w in W : L_TB(tau|w) = 0 for all tau})\n(|- ((--> (tb_manifold $w) AnalyticSubvariety) (stv 1.0 0.9)))\n\n;; D5: Detailed Balance Fiber\n(= (db_fiber V_DB s s_prime w) {w : DB(s,s_prime;w) holds})\n(|- ((==> (IntersectionAll (DBFibers $w)) (TBManifold $w)) (stv 1.0 0.9)))\n\n;; D6: Reward-Stratified Singular Fiber\n(= (reward_stratum V_r r w) {w in V_TB : PF(x|w) proportional R(x) on {R(x)=r}})\n(|- ((==> (NonTransversal (RewardStratum $r $w) (TBManifold $w)) (Singular (RewardStratum $r $w))) (stv 0.7 0.8)))\n\n;; D7: Temperature/Exploration Selector\n(= (temp_selector epsilon) (TempParam epsilon))\n(|- ((==> (TempSelector $eps) (ForwardPolicyScaled $eps)) (stv 1.0 0.9)))\n\n;; ============================================\n;; CLAIM C1 (PROVEN): R_an,exp definability of TB loss\n(|- ((==> (ForwardPolicy $w $x) (ExpDefinable $w $x)) (stv 1.0 0.95))\n    ((--> (log_partition $w) (Log (Integral (Exp (SublinearNet $x $w)) $x))) (stv 1.0 0.9))\n    ((--> (tb_loss $tau $w) (Square (Sum (LogDefinable $tau $w) (SquareNorm $tau $w))) (stv 1.0 0.9))\n    ((--> (R_an_exp_closure exp_polynomial_square_integral) (Definable tb_loss)) (stv 1.0 0.95)))\n\n;; C1 PLN Chain:\n;; ForwardPolicy = exp(sublinear_net) -> definable\n;; log(Z(w)) = log(integral exp(f) dx) over compact semialgebraic -> definable\n;; TB loss = squared sum of definable -> closed under exp + polynomial + square\n;; Therefore L_TB is R_an,exp-definable (stv 1.0 0.95)\n\n;; ============================================\n;; CLAIM C2 (CONJECTURAL): V_TB singular manifold, RLCT depends on reward structure\n(|- ((==> (ZeroSet (TBLoss $tau $w)) (TBManifold $w)) (stv 1.0 0.9))\n    ((--> (gauge_symmetry $w) (RescalingInvariant (ForwardPolicy $w))) (stv 0.8 0.7))\n    ((==> (GaugeSymmetry $w) (PositiveDim (TBManifold $w))) (stv 0.7 0.7)))\n\n;; C2a: Gauge symmetry - rescaling f by constant leaves PF proportional\n(|- ((==> (RescaleF $c $w) (PropForwardPolicy (ForwardPolicy $w))) (stv 0.8 0.7))\n    ((--> (gauge_orbifold $w) (OrbifoldStructure (TBManifold $w))) (stv 0.6 0.7)))\n\n;; C2b: RLCT depends on reward complexity - peaked rewards create higher lambda\n(|- ((==> (PeakedReward $R) (HigherLambda (TBManifold $w))) (stv 0.6 0.7))\n    ((--> (DiffuseReward $R) (LowerLambda (TBManifold $w))) (stv 0.6 0.7)))\n\n;; C2c: Partition function Z(w) singularity - NOVEL feature\n(|- ((==> (UnboundedF $w $x) (LogSingular (PartitionFn $w))) (stv 0.7 0.75))\n    ((--> (z_singularity $w) (CuspLossLandscape (PartitionFn $w))) (stv 0.6 0.7)))\n\n;; C2 PLN Chain:\n;; TB equation zero-set -> analytic subvariety V_TB\n;; Gauge symmetry (rescale f) -> positive dim V_TB\n;; Peaked reward -> complex Z(w) geometry -> higher lambda_TB\n;; Z(w) log singularity when f unbounded -> cusp absent from regression\n;; Caveat: No explicit lambda_TB bound in terms of reward complexity\n\n;; ============================================\n;; CLAIM C3 (CONJECTURAL): Temperature epsilon as U-shaped stratum selector\n(|- ((==> (LargeTemp $eps) (UniformPolicy $w)) (stv 0.7 0.7))\n    ((==> (UniformPolicy $w) (HighCodim (FlatFiber $w))) (stv 0.7 0.7))\n    ((==> (HighCodim (FlatFiber $w)) (HighLambda $eps)) (stv 0.7 0.7)))\n\n(|- ((==> (DecreasingTemp $eps) (ConcentratePolicy $w)) (stv 0.7 0.7))\n    ((==> (ConcentratePolicy $w) (LowerCodim (PeakFiber $w))) (stv 0.7 0.7))\n    ((==> (LowerCodim (PeakFiber $w)) (DecreasingLambda $eps)) (stv 0.7 0.7)))\n\n(|- ((==> (BelowEpsilonStar $eps) (CollapsePolicy $w)) (stv 0.7 0.7))\n    ((==> (CollapsePolicy $w) (NewSingularity (CollapseFiber $w))) (stv 0.7 0.7))\n    ((==> (NewSingularity (CollapseFiber $w)) (IncreasingLambda $eps)) (stv 0.7 0.7)))\n\n;; C3 PLN Chain:\n;; eps -> infinity: PF uniform -> V_flat high codim -> high lambda\n;; eps decreasing: PF concentrates -> V_peak lower codim -> lambda decreasing\n;; eps < eps*: PF collapses to delta -> V_collapse new singularity -> lambda increasing\n;; Net: U-shaped lambda(epsilon) with minimum at eps*\n;; Caveat: Transversality between V_TB and V_epsilon not established\n\n;; ============================================\n;; CLAIM C4 (CONJECTURAL): Generalization bound with C_Z/n partition estimation term\n(|- ((==> (GFlowNetGen $n $eps) (LEQ (GenError $n $eps) (Add (Mul (LambdaTB $eps) (Div (Log $n) (* 2 $n))) (Div (U_fluct $eps) (Sqrt $n)) (Div C_Z $n)))) (stv 0.6 0.75))\n    ((--> (C_Z_term $n) (PartitionEstError $n)) (stv 0.7 0.8)))\n\n;; C4 PLN Chain:\n;; Standard SLT: GenError <= lambda*log(n)/(2n) + U/sqrt(n)\n;; GFlowNet adds: C_Z/n from Z(w) estimation via Monte Carlo\n;; C_Z ~ O(1/sqrt(K)) for K samples -> couples gen to partition estimation quality\n;; Caveat: C_Z bound depends on Z(w) estimator; Monte Carlo gives O(1/sqrt(K))\n;; NOVEL: C_Z/n term absent from all prior SLT bounds (EBMs, VAEs approximate differently)\n\n;; ============================================\n;; CLAIM C5 (CONJECTURAL): Phase transition at critical temperature epsilon*\n(|- ((==> (TempAt $eps) (PhaseTransition $eps)) (stv 0.6 0.7))\n    ((--> (explore_dominated $eps) (MultiModalLLC $eps)) (stv 0.6 0.7))\n    ((--> (exploit_dominated $eps) (UniModalLLC $eps)) (stv 0.6 0.7)))\n\n(|- ((==> (RewardComplexity $K_R) (EpsilonStarFormula (* C (Inv (Sqrt $K_R))))) (stv 0.5 0.7))\n    ((==> (DBvsTB $method) (HigherEpsilonStar DB TB)) (stv 0.5 0.7)))\n\n;; C5 PLN Chain:\n;; At eps*: transition from exploration (multimodal LLC) to exploitation (unimodal LLC)\n;; eps* ~ C/sqrt(K_R) where K_R = effective reward modes\n;; DB has higher eps* than TB (per-edge constraint stronger than global)\n;; Caveat: eps* formula not derived from first principles; needs SGLD validation\n\n;; ============================================\n;; CROSS-REFERENCES\n;; #12 (RLCT x OT): partition function and transport plan as precursors\n;; #167 (Diffusion): score gradient vs reward-proportional sampling\n;; #311/#360 (Flow Matching): deterministic vector field vs stochastic policy\n;; #515 (VAE): ELBO lower bound vs exact TB constraint\n;; #609 (LoRA): low-rank converse for GFlowNet contrast\n;; #434 (MoE): routing gate covariance vs TB terminal enforcement\n;; #409 (Gumbel-Softmax): G10 connects to G4_flat\n;; #362 (CFG): guidance scale vs temperature epsilon (shared U-shape, distinct mechanism)\n;; #507 (Score Matching): score-based vs reward-based\n;; #163 (Normalizing Flows): bijective regular (RLCT=d/2) vs graphical singular\n;; #354 (STE): continuous surrogate vs discrete trajectory\n\n;; ============================================\n;; CAVEATS\n;; 1. No explicit lambda_TB bound in terms of reward complexity (C2 gap)\n;; 2. Gauge symmetry orbifold RLCT vs manifold RLCT not established (C2a gap)\n;; 3. Transversality V_TB x V_epsilon not proven (C3 gap)\n;; 4. C_Z bound depends on Z(w) estimator quality (C4 gap)\n;; 5. epsilon* formula heuristic, not first-principles derived (C5 gap)