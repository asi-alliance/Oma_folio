;; Synthesis #871: Decision Transformer × RLCT — L3 MeTTa encoding\n;; Offline RL as supervised sequence modeling × Real Log Canonical Threshold\n;; 2026-11-07 | C1 proven, C2-C5 conjectural | Extends #870\n\n;; Type declarations\n(: GRPO Concept)\n(: DecisionTransformer Concept)\n(: RTGTarget Concept)\n(: StateToken Concept)\n(: ActionToken Concept)\n(: CausalContext Concept)\n(: ContextWindow Concept)\n(: RTGFiberFamily Concept)\n(: StitchingBias Concept)\n(: PhaseTransitionK Concept)\n\n;; D atoms\n(= D1 (==> (--> algo DecisionTransformer) (&& (--> algo AutoregressiveModel) (--> algo RTGConditioned) (--> algo CausalAttention))) (stv 1.0 0.95))\n(= D2 (==> (--> algo DecisionTransformer) (--> (loss-fn algo) L_DT)) (stv 1.0 0.95))\n(= D3 (==> (--> algo DecisionTransformer) (--> (loss-type algo) supervised-sequence)) (stv 1.0 0.95))\n(= D4 (==> (&& (--> algo DecisionTransformer) (= (rtg-embed algo) W_R)) (--> algo RTGInjected)) (stv 1.0 0.9))\n(= D5 (==> (--> algo DecisionTransformer) (--> (context-window algo) ContextWindow)) (stv 0.9 0.85))\n(= D6 (==> (--> algo DecisionTransformer) (--> (kl-coef algo) none)) (stv 0.8 0.85))\n(= D7 (==> (--> algo DecisionTransformer) (--> (stitching-bias algo) RTG-mismatch)) (stv 0.85 0.85))\n\n;; C1 PROVEN — R_an,exp definability of L_DT\n(= C1 (==> (--> algo DecisionTransformer) (--> (loss algo) R_an_exp-definable)) (stv 1.0 0.95))\n\n;; C2 CONJECTURAL — RTG-conditioned singular fiber family\n(= C2 (==> (--> algo DecisionTransformer) (= (singular-fiber algo) (RTGFiberFamily Rhat))) (stv 0.6 0.7))\n\n;; C3 CONJECTURAL — context window K as discrete stratum selector\n(= C3 (==> (--> algo DecisionTransformer) (= (RLCT algo) (* (RLCT_BC algo) (+ 1 (/ (- (RLCT_full algo) (RLCT_BC algo)) (+ K K_0)))))) (stv 0.55 0.7))\n\n;; C4 CONJECTURAL — generalization bound with stitching bias\n(= C4 (==> (--> algo DecisionTransformer) (= (gen-bound algo) (+ (/ (* (lambda_DT algo) (log n)) (* 2 n)) (/ (U_stitch algo) (sqrt n))))) (stv 0.55 0.7))\n\n;; C5 CONJECTURAL — stitching phase transition at K*\n(= C5 (==> (--> algo DecisionTransformer) (--> (context-window algo) PhaseTransitionK)) (stv 0.5 0.7))\n\n;; PLN chains\n(|- (Implication (Inheritance DecisionTransformer (IntSet SupervisedSequenceModel))\n    (Inheritance DecisionTransformer (IntSet RLCTWellDefined))) (stv 0.9 0.9))\n\n(|- (Implication (Inheritance RTGTarget (IntSet ContinuousConditioning))\n    (Inheritance RTGFiberFamily (IntSet OneParamFiber))) (stv 0.7 0.8))\n\n;; Caveats\n;; 1. K/(K+K_0) scaling is conjectural by analogy to #870 G/(G+G_0)\n;; 2. RTG foliation may have singular parameter values Rhat*\n;; 3. Causal mask boundary singularities at K unexplored\n;; 4. Multi-game DT game-identity as additional stratum selector not modeled\n;; 5. Online DT trajectory generation may add sampling-induced singular structure\n\n;; Cross-refs: #8 #100 #414 #468 #136 #584 #870 #570 #533 #379