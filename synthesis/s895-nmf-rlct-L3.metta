;; Synthesis #895: NMF × RLCT — L3 MeTTa Encoding (Boundary Strata Focus)\n;; Date: 2026-11-12\n;; Extends arxiv 2609.34043 (interior positive case) to boundary regime\n\n;; ============================================================\n;; D1: Model Definition\n;; NMF factorization: V = W H, W >= 0 (m×k), H >= 0 (k×n)\n;; Parameter: theta = (W, H) in R+^{2mk}\n;; Loss: L(theta) = ||V - WH||_F^2 (polynomial, semialgebraic domain)\n\n(metta\n  (|- ((--> (× NMF-model (× $W $H)) factorization)\n      (stv 1.0 0.95))\n    ((--> $W non-negative-matrix)\n     (--> $H non-negative-matrix)\n     (= (loss NMF $W $H) (|| V (* $W $H) ||_F^2)))))\n\n;; D2: KL/Loss as Polynomial on Semialgebraic Set\n;; C1 PROVEN: L(theta) is polynomial in (W,H), restricted to R+^{2mk}\n;; This is R_an definable (polynomial = restricted analytic)\n\n(metta\n  (|- ((==> (× (--> $theta NMF-parameter)\n             (= ($theta) (in-rplus-orthant $theta)))\n        (R_an-definable (KL NMF $theta)))\n      (stv 1.0 0.95))\n    ((--> NMF-loss polynomial)\n     (--> non-negative-orthant semialgebraic-set)\n     (--> (× polynomial semialgebraic-set) R_an-definable))))\n\n;; ============================================================\n;; D4: Singular Fiber — Boundary Strata (NOVEL: extends 2609.34043)\n;; Paper 2609.34043 assumes strictly positive interior.\n;; Boundary strata arise when entries are exactly zero.\n\n;; Interior fiber (covered by paper): S_k × (R+*)^k\n;; Dimension: k (from continuous scaling)\n\n(metta\n  (|- ((--> (× NMF-interior-fiber $W $H) fiber)\n      (stv 1.0 0.9))\n    ((--> (× S_k (R+*)^k) group-action)\n     (= (dim NMF-interior-fiber) k)\n     (--> (R+*)^k non-compact-fiber))))\n\n;; Column-zero boundary stratum: W_{:,j} = 0 for some j\n;; Then H_{j,:} is unconstrained (free parameter direction)\n;; Fiber dimension increases: k + z*n (z zeroed columns)\n\n(metta\n  (|- ((--> (× NMF-boundary-column-zero $W $H $z) fiber)\n      (stv 0.9 0.85))\n    ((exists $j (column-zero $W $j))\n     (unconstrained $H $j)\n     (= (dim NMF-boundary-column-zero) (+ k (* $z n))))))\n\n;; Key distinction: non-compact scaling fiber (R+*)^k vs PCA compact O(r)\n;; Non-compact fibers create logarithmic RLCT contributions\n\n(metta\n  (|~ ((Implication\nn        (Inheritance NMF-scaling-fiber (IntSet NonCompact))\n        (Inheritance NMF-scaling-fiber RLCT-inflating))\n      (stv 0.8 0.8))\n    ((Inheritance (R+*)^k NonCompact)\n     (Inheritance O(r) Compact))))\n\n;; ============================================================\n;; D5: Non-negative Rank as Stratum Selector\n;; rank_+(V) >= rank_lin(V), strict inequality possible\n;; Phase transition at k* = rank_+(V), NOT rank_lin(V)\n\n(metta\n  (|- ((==> (× (< $k rank-plus $V)) (--> (loss NMF $k) bounded-below-positive))\n        (> (RLCT NMF $k) 0))\n      (stv 0.9 0.8))\n    ((--> rank-plus non-negative-rank)\n     (>= rank-plus rank-lin)\n     (= (phase-transition NMF) rank-plus)))\n\n;; U-shaped RLCT prediction\n;; k < rank_+(V): lambda decreases (approaching zero-loss)\n;; k = rank_+(V): lambda locally minimal\n;; k > rank_+(V): lambda increases (boundary strata dominate)\n\n(metta\n  (|- ((==> (× (> $k rank-plus $V)) (boundary-dominated $k))\n        (> (RLCT NMF $k) (RLCT NMF rank-plus)))\n      (stv 0.75 0.75))\n    ((--> column-zero-stratum dominant-singular-locus)\n     (--> boundary-strata RLCT-inflating))))\n\n;; ============================================================\n;; D6: Generalization Bound\n;; Gen_NMF <= lambda_NMF / n + U(W,H) / sqrt(n)\n;; U = k (interior) or k + z*max(m,n) (boundary)\n\n(metta\n  (|- ((==> (× (--> $theta NMF-parameter) (interior-stratum $theta))\n        (<= (Gen-error NMF $theta n)\n            (+ (/ lambda-NMF n) (/ k (sqrt n)))))\n      (stv 0.85 0.85))\n    ((= U-interior k)\n     (--> NMF-scaling-fiber non-compact-fiber))))\n\n(metta\n  (|- ((==> (× (--> $theta NMF-parameter) (boundary-stratum $theta $z))\n        (<= (Gen-error NMF $theta n)\n            (+ (/ lambda-NMF-boundary n)\n               (/ (+ k (* $z (max m n))) (sqrt n)))))\n      (stv 0.7 0.7))\n    ((= U-boundary (+ k (* $z (max m n))))\n     (--> column-zero-stratum free-parameter-direction))))\n\n;; ============================================================\n;; D7: Phase Transition & SGLD Signature\n;; Interior-to-boundary transition: LLC shows kink/jump\n;; as dominant singularity type changes\n\n(metta\n  (|- ((==> (× (increasing $k) (> $k rank-plus $V))\n        (interior-to-boundary-transition $k))\n      (stv 0.7 0.7))\n    ((--> column-zero-stratum dominant)\n     (--> LLC-signature kink-or-jump)\n     (! (--> LLC-signature smooth-U-shape))))\n\n;; Toric resolution approach (alternative to paper's normal form)\n;; Non-negative orthant = toric variety, (R+*)^k = torus action\n;; Newton polyhedron of toric fan gives explicit RLCT\n\n(metta\n  (|- ((==> (× (toric-variety non-negative-orthant)\n             (torus-action (R+*)^k))\n        (computable-via (RLCT NMF) toric-resolution))\n      (stv 0.7 0.7))\n    ((--> non-negative-orthant toric-variety)\n     (--> (R+*)^k torus-action)\n     (--> toric-boundary-divisors log-discrepancy-RLCT))))\n\n;; ============================================================\n;; PLN Reasoning Chains\n\n;; Chain 1: Non-compact fiber → RLCT inflation\n(metta\n  (|~ ((Implication\nn        (Inheritance NMF-scaling-fiber NonCompactContinuous))\n        (Implication\n          (Inheritance NMF-scaling-fiber FiberOfSingularModel)\n          (Inheritance NMF RLCTInflated)))\n      (stv 0.8 0.8))\n    ((Inheritance (R+*)^k NonCompactContinuous)\n     (Inheritance NMF-scaling-fiber FiberOfSingularModel)\n     (! (Inheritance (R+*)^k Compact))))\n\n;; Chain 2: Boundary stratum dominance for k > rank_+\n(metta\n  (|~ ((Implication\nn        (Inheritance NMF-boundary-stratum DominantForOverparam))\n        (Implication\n          (> $k rank-plus)\n          (> (RLCT NMF $k) (RLCT NMF rank-plus))))\n      (stv 0.7 0.7))\n    ((Inheritance column-zero-stratum BoundarySingularity)\n     (Inheritance BoundarySingularity RLCTInflating)))\n\n;; Chain 3: NMF vs PCA phase transition gap\n(metta\n  (|~ ((Implication\nn        (Inheritance NonNegativityGap Positive))\n        (Implication\n          (> rank-plus rank-lin)\n          (> (PhaseTransition NMF) (PhaseTransition PCA))))\n      (stv 0.75 0.8))\n    ((Inheritance NonNegativityGap (IntSet Positive))\n     (= (PhaseTransition NMF) rank-plus)\n     (= (PhaseTransition PCA) rank-lin)))\n\n;; ============================================================\n;; Caveats\n;; 1. C1 PROVEN (R_an definability). C2-C5 CONJECTURAL.\n;; 2. arxiv 2609.34043 covers interior positive case with RLCT upper bound.\n;; 3. Boundary strata, toric resolution, non-negative rank distinction,\n;;    interior-to-boundary transition, SGLD predictions are novel.\n;; 4. Non-compact fiber RLCT inflation is predicted but not proven.\n;; 5. Toric resolution computation is a target, not yet executed.\n\n;; ============================================================\n;; Cross-References\n;; #833 (PCA rank stratification), #885 (ICA scaling fiber),\n;; #510 (SAE dictionary learning), #56 (ReLU toric resolution),\n;; #69 (compact vs non-compact fiber lesson), #88 (tensor decomp),\n;; #114 (PCA rank deficiency), #886 (HMM), #887 (UMAP)\n\n;; ============================================================\n;; Status: L3 written 2026-11-12. Boundary strata MeTTa encoding complete.\n;; Next: L4 summary + L5 catalog append.