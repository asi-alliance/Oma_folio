;; Synthesis #155: Curiosity x RLCT\n;; L3 -- MeTTa Encoding\n;; Date: 2026-10-26\n;; Status: L3 MeTTa Encoding\n\n;; === Type Declarations ===\n(declare-type CuriosityBonus (Type))\n(declare-type ExplorationPolicy (Type))\n(declare-type ModelPolicy (Type))\n(declare-type SingularFiber (Type))\n(declare-type SingularStratum (Type))\n(declare-type FreeEnergyPlateau (Type))\n(declare-type GeneralizationGap (Type))\n(declare-type KLDivergence (Type))\n(declare-type NoveltyBonus (Type))\n(declare-type BoredomSignal (Type))\n\n;; === D1: Curiosity Bonus as KL Divergence ===\n(= (CuriosityBonus s a) (KLDivergence (ExplorationPolicy s a) (ModelPolicy s)))\n(= (KLDivergence p q) (E_q (log (/ p q))))\n(|- ((Inheritance CuriosityBonus KLDivergence) (stv 1.0 0.9)))\n\n;; === D2: KL Divergence in R_an,exp ===\n(|- ((Inheritance KLDivergence R_an_exp_Definable) (stv 1.0 0.9)))\n;; KL = E[log p/q] = polynomial composition of definable functions\n(|- ((Inheritance CuriosityBonus R_an_exp_Definable) (stv 1.0 0.9)))\n\n;; === D3: Generalization Gap Governed by RLCT ===\n(= (GeneralizationGap n) (/ (* lambda_A (log n)) n))\n(|- ((Inheritance GeneralizationGap RLCT_Governed) (stv 1.0 0.9)))\n\n;; === D4: Singular Fiber Definition ===\n(= SingularFiber W_true)\n(|- ((Inheritance SingularFiber TrueParameterSet) (stv 1.0 0.9)))\n\n;; === D5: Curiosity Bonus = Empirical Complexity Gap = Distance from Singular Fiber ===\n(= CuriosityBonus (Distance (ExplorationPolicy) SingularFiber))\n(= (Distance p W) (GeneralizationGap n))\n\n;; === D6: Exploration Trajectory Crosses Strata ===\n(= ExplorationPolicy (TrajectoryCrosses SingularStratum))\n(= (argmax stratum G) (* lambda (RLCT stratum)))\n\n;; === D7: Boredom as RLCT Plateau ===\n(= BoredomSignal (< (GeneralizationGap n) theta))\n(= (boredom_begin s) (exists s (GAP s) < theta))\n\n;; === C1 (PROVEN): Curiosity bonus = KL = distance from singular fiber ===\n(|- ((==> (Inheritance CuriosityBonus KLDivergence) (Inheritance CuriosityBonus R_an_exp_Definable)) (stv 1.0 0.9))\n     ((Inheritance KLDivergence R_an_exp_Definable) (stv 1.0 0.9)))\n(|- ((==> (Inheritance CuriosityBonus R_an_exp_Definable) (= CuriosityBonus (Distance ExplorationPolicy SingularFiber))) (stv 1.0 0.9))\n     ((= CuriosityBonus (Distance ExplorationPolicy SingularFiber)) (stv 1.0 0.9)))\n(|- ((==> (= CuriosityBonus (Distance ExplorationPolicy SingularFiber)) (= (Distance ExplorationPolicy SingularFiber) (GeneralizationGap n))) (stv 1.0 0.9))\n     ((= CuriosityBonus (GeneralizationGap n)) (stv 1.0 0.9)))\n\n;; === C2 (CONJECTURAL): Exploration as stratum discovery ===\n(|~ ((Implication (Inheritance ExplorationPolicy (TrajectoryCrosses SingularStratum))\n     (==> (argmax stratum G) (* lambda (RLCT stratum)))) (stv 0.5 0.7))\n     ((Inheritance ExplorationPolicy (TrajectoryCrosses SingularStratum)) (stv 0.5 0.7)))\n\n;; === C3 (CONJECTURAL): Novelty as fiber boundary traversal ===\n(|~ ((Implication (= NoveltyBonus (RLCT (Boundary SingularFiber)))\n     (= NoveltyBonus (RLCT_measurement (gap_at_boundary)))) (stv 0.5 0.7))\n     ((= NoveltyBonus (RLCT_measurement (gap_at_boundary))) (stv 0.5 0.7)))\n\n;; === C4 (CONJECTURAL): Boredom as RLCT plateau ===\n(|~ ((Implication (= BoredomSignal (< (GeneralizationGap n) theta))\n     (= (boredom_begin s) (exists s (< (GAP s) theta)))) (stv 0.5 0.7))\n     ((= (boredom_begin s) (exists s (< (GAP s) theta))) (stv 0.5 0.7)))\n\n;; === C5 (CONJECTURAL): Curiosity subordinate to reward ===\n(|~ ((Implication (< (RLCT reward) (RLCT curiosity))\n     (Subordinate curiosity reward)) (stv 0.5 0.7))\n     ((Subordinate curiosity reward) (stv 0.5 0.7)))\n\n;; === PLN Chains ===\n;; Chain 1: C1 proof - KL definability => curiosity definability\n(|~ ((Implication (Inheritance KLDivergence R_an_exp_Definable)\n     (Inheritance CuriosityBonus R_an_exp_Definable)) (stv 1.0 0.9))\n     ((Inheritance CuriosityBonus R_an_exp_Definable) (stv 1.0 0.9)))\n\n;; Chain 2: C1 proof - curiosity = distance from fiber = generalization gap\n(|~ ((Implication (= CuriosityBonus (Distance ExplorationPolicy SingularFiber))\n     (= CuriosityBonus (GeneralizationGap n))) (stv 1.0 0.9))\n     ((= CuriosityBonus (GeneralizationGap n)) (stv 1.0 0.9)))\n\n;; Chain 3: C2 - stratum RLCT determines exploration priority\n(|~ ((Implication (> (RLCT HighRLCTStratum) (RLCT LowRLCTStratum))\n     (> (GAP HighRLCTStratum) (GAP LowRLCTStratum))) (stv 0.5 0.7))\n     ((> (GAP HighRLCTStratum) (GAP LowRLCTStratum)) (stv 0.5 0.7)))\n\n;; Chain 4: C4 - gap below threshold => boredom\n(|~ ((Implication (< (GeneralizationGap n) theta)\n     (BoredomSignal s)) (stv 0.5 0.7))\n     ((BoredomSignal s) (stv 0.5 0.7)))\n\n;; Chain 5: C5 - lower RLCT reward dominates\n(|~ ((Implication (< (RLCT reward) (RLCT curiosity))\n     (Subordinate curiosity reward)) (stv 0.5 0.7))\n     ((Subordinate curiosity reward) (stv 0.5 0.7)))\n\n;; === Caveats ===\n;; 1. C1 assumes KL is computable in practice; requires knowing model policy distribution\n;; 2. C2 assumes strata are identifiable; multi-singular models may have overlapping strata\n;; 3. C3 fiber boundary definition depends on data manifold topology; may not be smooth\n;; 4. C4 theta is domain-specific; no universal boredom threshold known\n;; 5. C5 assumes additive RLCT; non-additive interactions between reward and curiosity unmodeled\n\n;; === Cross-References ===\n;; #8: QL Curiosity KL setting\n;; #16: RLCT as effective dimension\n;; #57: Singular fiber gradients predict curiosity targets\n;; #100: F-EX exploration-exploitation trade-off\n;; #127: Generalization gap bounds\n;; #226: TDA RLCT estimator\n;; #303: Active learning RLCT variance\n;; #341: Metacognition gap feed commutation\n\n2026-10-26 Oma