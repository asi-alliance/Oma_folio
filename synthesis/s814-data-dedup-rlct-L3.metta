# Synthesis #814: Data Deduplication x RLCT - L3 MeTTa Encoding\n# Date: 2026-10-28\n# Status: L3 MeTTa\n# From: L1 at s814-data-dedup-rlct-L1.md, L2 NOVEL\n\n---\n\n# MeTTa Type Declarations\n\n(: ParameterSpace Type)\n(: MultiplicityWeight Type)\n(: SingularFiber Type)\n(: DedupRatio Type)\n(: StratumSelector Type)\n(: GenBound Type)\n(: PhaseTransition Type)\n(: RealAnalytic Type)\n(: LossLandscape Type)\n(: Claim Type)\n\n---\n\n# MeTTa Atom Declarations\n\n;; D1: Multiplicity-weighted empirical loss\n(= (dup-loss $theta $m $n)\n   (/ (sum-over-j (* (m-of $m $j) (ell $theta $j))) $n))\n\n;; D2: Deduplicated loss (uniform weights)\n(= (dedup-loss $theta $n-prime)\n   (/ (sum-over-j-prime (ell $theta $j-prime)) $n-prime))\n\n;; D3: R_an,exp definability - C1 PROVEN\n(= (multiplicity-weighted-analytic $theta $m $n)\n   (R-an-exp-closure (dup-loss $theta $m $n)))\n\n;; D4: Multiplicity-induced singular fiber (local geometry differs)\n(= (dup-fiber $theta $m)\n   (intersection (set-of $w (= (ell $w $j) 0))))\n\n(= (dedup-fiber $theta)\n   (intersection (set-of $w (= (ell $w $j-prime) 0))))\n\n;; D5: Dedup threshold epsilon as stratum selector\n(= (epsilon-cluster $eps $D)\n   (cluster-set $eps $D))\n\n(= (dedup-ratio-selector $eps $n $n-prime)\n   (/ $n-prime $n))\n\n;; D6: Generalization bound with dedup ratio r\n(= (gen-bound-dedup $lambda-r $r $n $U-r)\n   (+ (/ (* $lambda-r (log (* $r $n))) (* 2 $r $n))\n      (/ $U-r (sqrt (* $r $n)))))\n\n;; D7: Phase transition at optimal dedup ratio r*\n(= (optimal-dedup-ratio $lambda-0 $alpha $n $U)\n   (argmin (lambda $r (gen-bound-dedup (- $lambda-0 (* $alpha (- 1 $r))) $r $n $U))))\n\n---\n\n# MeTTa Claims\n\n;; C1 (PROVEN): R_an-definability of multiplicity-weighted loss\n(|- ((==> (dup-loss $theta $m $n)\n          (R-an-definable (multiplicity-weighted-analytic $theta $m $n)))\n     (stv 1.0 0.95))\n\n;; C2 (CONJECTURAL): Multiplicity inflates RLCT through local geometry\n(|- ((==> (dup-fiber $theta $m)\n          (>= (lambda-dup $theta $m) (lambda-dedup $theta)))\n     (stv 0.5 0.7))\n\n;; C3 (CONJECTURAL): Dedup threshold epsilon as stratum selector\n(|- ((==> (> (epsilon-cluster $eps1 $D) (epsilon-cluster $eps2 $D))\n          (stratum-transition $eps1 $eps2))\n     (stv 0.5 0.7))\n\n;; C4 (CONJECTURAL): Generalization bound with optimal dedup ratio\n(|- ((==> (gen-bound-dedup $lambda-r $r $n $U-r)\n          (<= (generalization-error $n) (gen-bound-dedup $lambda-r $r $n $U-r)))\n     (stv 0.5 0.7))\n\n;; C5 (CONJECTURAL): Phase transition at r*\n(|- ((==> (= $r (optimal-dedup-ratio $lambda-0 $alpha $n $U))\n          (phase-transition-at $r))\n     (stv 0.5 0.7))\n\n---\n\n# PLN Chains\n\n;; PLN-1: C1 Proven - finite sum of R_an,exp with integer coefficients\n(|~ ((Implication (Inheritance $ell R-an-exp)\n                  (Inheritance (finite-sum $ell $k) R-an-exp))\n     (stv 1.0 0.9))\n    ((Inheritance (ell $theta $j) R-an-exp) (stv 1.0 0.9)))\n\n;; PLN-2: C2 - multiplicity changes local geometry not zero-loss set\n(|~ ((Implication (Inheritance (dup-fiber $theta $m) SameZeroSet)\n                  (Inheritance (dup-fiber $theta $m) DifferentLocalGeometry))\n     (stv 0.6 0.7))\n    ((Inheritance (dup-fiber $theta $m) SameZeroSet) (stv 0.7 0.8)))\n\n;; PLN-3: C3 - epsilon threshold controls stratum partition\n(|~ ((Implication (Inheritance (epsilon-cluster $eps $D) CoarsePartition)\n                  (Inheritance (dedup-ratio-selector $eps $n $n-prime) StratumSelector))\n     (stv 0.6 0.7))\n    ((Inheritance (epsilon-cluster $eps $D) CoarsePartition) (stv 0.5 0.8)))\n\n;; PLN-4: C4 - gen bound trades lambda reduction against sample size\n(|~ ((Implication (Inheritance (gen-bound-dedup $lambda-r $r $n $U-r) Bound)\n                  (Implication (< $r 1)\n                                (Implication (< $lambda-r $lambda-dup)\n                                              (<= (gen-bound-dedup $lambda-r $r $n $U-r)\n                                                  (gen-bound-dup $lambda-dup 1 $n $U-r)))))\n     (stv 0.5 0.7))\n    ((Inheritance (gen-bound-dedup $lambda-r $r $n $U-r) Bound) (stv 0.5 0.8)))\n\n;; PLN-5: C5 - U-shaped LLC at varying dedup ratios\n(|~ ((Implication (Inheritance (optimal-dedup-ratio $lambda-0 $alpha $n $U) CriticalPoint)\n                  (Implication (Inheritance $r DedupRatio)\n                                (Implication (< $r (optimal-dedup-ratio $lambda-0 $alpha $n $U))\n                                              (Inheritance (llc $r) Decreasing))))\n     (stv 0.5 0.7))\n    ((Inheritance (optimal-dedup-ratio $lambda-0 $alpha $n $U) CriticalPoint) (stv 0.5 0.8)))\n\n---\n\n# Caveats\n;; 1. V_0^dup = V_0^dedup as sets — multiplicity changes local geometry not zero-loss set\n;; 2. Exact k-fold RLCT scaling (log(k) vs k^(-1/2)) unresolved\n;; 3. Near-duplicate epsilon threshold discontinuity: continuous eps -> discrete cluster structure\n;; 4. Functional form lambda(r) assumed linear — empirical validation needed\n;; 5. SGLD LLC phase transition prediction untested\n\n---\n\n# Cross-References\n;; #582 Curriculum Learning (ordering on deduped data)\n;; #543 Dataset Distillation (compression vs removal)\n;; #253 Model Collapse (dedup as regularizer against collapse)\n;; #548 Mixup (interpolation vs removal)\n;; #327 Pseudo-Labeling (dedup of pseudo-labeled data)\n;; #178 Unlearning (data-side removal analogy)\n;; #433 Weight Decay (parameter regularization vs data regularization)\n;; #169 Dropout (stochastic regularization vs deterministic dedup)\n;; #224 Label Smoothing (output regularization vs input data structure)\n;; #8 Foundational RLCT