;; Synthesis #880: N-gram Language Model x RLCT --- L3 MeTTa Encoding\n;; Date: 2026-11-09\n;; Atoms D1-D7, Claims C1-C5\n\n;; D1: Vocabulary and token sequence\n(= (Vocabulary $V) (FiniteSet $V))\n(= (TokenSequence $x $T) (Tuple $x $T))\n(= (Indicator $x_t $v) (BoolFn $x_t $v))\n\n;; D2: Context and counts\n(= (Context $n $t) (TupleN $x_{t-n+1} ... $x_{t-1}))\n(= (ContextCount $c) (SumOver $t (Indicator $c_t $c)))\n(= (JointCount $c $w) (SumOver $t (And (Indicator $c_t $c) (Indicator $x_t $w))))\n(= (ContextCountPartition $c) (= (ContextCount $c) (SumOver $w (JointCount $c $w))))\n\n;; D3: N-gram likelihood\n(= (NgramParameterSpace $n $V)\n   (ProductSimplex (Expt $V (- $n 1)) $V))\n(= (NgramDim $n $V)\n   (* (Expt $V (- $n 1)) (- $V 1)))\n(= (NgramLogLikelihood $p $x $n)\n   (Neg (Scale (/ 1 $T) (SumOver $c $w (* (JointCount $c $w) (Log (Conditional $p $w $c)))))))\n(= (MLE $c $w) (/ (JointCount $c $w) (ContextCount $c)))\n\n;; D4: Zero-count fiber\n(= (ZeroCountContexts $n)\n   (SetOf $c (= (ContextCount $c) 0)))\n(= (ZeroCountFiber $n $V)\n   (SetOf $p (ForAll $c (In $c (ZeroCountContexts $n)) (Unconstrained (Conditional $p $c)))))\n(= (FiberDim $n $V)\n   (* (Cardinality (ZeroCountContexts $n)) (- $V 1)))\n(= (SingularLocus $n)\n   (ZeroFisherInfo (ZeroCountContexts $n)))\n\n;; D5: Smoothing operators\n(= (AddKSmooth $k $c $w)\n   (/ (+ (JointCount $c $w) $k) (+ (ContextCount $c) (* $k $V))))\n(= (GoodTuring $r)\n   (/ (* (+ $r 1) (CountOfCount (+ $r 1))) (CountOfCount $r)))\n(= (KneserNey $D $c $w $n)\n   (+ (/ (Max (- (JointCount $c $w) $D) 0) (ContextCount $c))\n      (* (Lambda $c $D) (KneserNey $D (Suffix $c) $w (- $n 1)))))\n(= (Lambda $c $D)\n   (/ (* $D (ContextCount $c)) (NumObserved $c)))\n(= (Desingularized $S) (SmoothMap $S (NgramParameterSpace $n $V)))\n\n;; D6: RLCT definition\n(= (NgramKL $q $p)\n   (SumOver $c $w (* (JointDist $q $c $w) (Log (/ (Conditional $q $w $c) (Conditional $p $w $c))))))\n(= (OptimalParams $n $q)\n   (SetOf $p (= (NgramKL $q $p) 0)))\n(= (ZFunction $n $T)\n   (Integral (NgramParameterSpace $n $V) (Exp (Neg (* $T (NgramKL $q $p))))))\n(= (RLCT $n $V)\n   (AsymptoticExponent (ZFunction $n $T) $T))\n\n;; D7: Phase transition order n*\n(= (CriticalOrder $V $n_samples)\n   (Max $n (<= (* (Expt $V (- $n 1)) (- $V 1)) (/ $n_samples (Log $n_samples)))))\n(= (SparsityRatio $n $V)\n   (/ (Cardinality (ZeroCountContexts $n)) (Expt $V (- $n 1))))\n(= (LLCProfile $n $n_star)\n   (cond ((< $n $n_star) (Regular 0))\n         ((= $n $n_star) (Kink $n_star))\n         ((> $n $n_star) (Singular (* (/ (- $V 1) 2) (Expt $V (- $n 1)))))))\n\n;; C1 (PROVEN): R_an-definability of n-gram likelihood\n(|- ((==> (NgramLogLikelihood $p $x $n) (R_an-definable)) (stv 1.0 0.95))\n    ((CountingPolynomial-semialgebraic) (stv 1.0 0.95))\n    ((MLE-rational-function) (stv 1.0 0.95))\n    ((Log-of-rational-subanalytic) (stv 1.0 0.95)))\n\n;; C2 (CONJECTURAL): Zero-count fiber RLCT = (V-1)/2 per unobserved context\n(|- ((==> (In $c (ZeroCountContexts $n))\n          (= (RLCT-contribution $c $V) (/ (- $V 1) 2))) (stv 0.6 0.7))\n    ((Free-simplex-fiber-d-dim) (stv 1.0 0.9))\n    ((Watanabe-multinomial-RLCT) (stv 0.7 0.8))\n    ((No-inter-context-coupling) (stv 0.5 0.6)))\n\n(|- ((==> (NgramKL $q $p)\n          (= (RLCT $n $V) (+ (* (/ (- $V 1) 2) (Cardinality (ZeroCountContexts $n)))\n                             (RegularRLCT $n $V)))) (stv 0.55 0.7))\n    ((C2-per-context) (stv 0.6 0.7))\n    ((Regular-part-zero-RLCT) (stv 0.8 0.85)))\n\n;; C3 (CONJECTURAL): Markov order n as discrete stratum selector\n(|- ((==> (SparsityRatio $n $V)\n          (= (RLCT $n $V) (* (/ (- $V 1) 2) (SparsityRatio $n $V) (Expt $V (- $n 1))))) (stv 0.55 0.7))\n    ((C2-per-context) (stv 0.6 0.7))\n    ((Sparsity-ratio-approximates-zero-counts) (stv 0.7 0.8)))\n\n(|- ((==> (< $n (CriticalOrder $V $n_samples))\n          (ApproxZero (RLCT $n $V))) (stv 0.5 0.7))\n    ((Most-contexts-observed) (stv 0.7 0.8))\n    ((Regular-model-low-RLCT) (stv 0.8 0.85)))\n\n(|- ((==> (> $n (CriticalOrder $V $n_samples))\n          (Approx (RLCT $n $V) (* (/ (- $V 1) 2) (Expt $V (- $n 1))))) (stv 0.5 0.7))\n    ((Most-contexts-unobserved) (stv 0.7 0.8))\n    ((Singular-fiber-dominates) (stv 0.6 0.7)))\n\n;; C4 (CONJECTURAL): Smoothing increases RLCT (desingularization)\n(|- ((==> (Desingularized (AddKSmooth $k))\n          (= (RLCT-smoothed $n $V) (/ (NgramDim $n $V) 2))) (stv 0.6 0.75))\n    ((AddK-removes-zero-count-singularity) (stv 1.0 0.9))\n    ((Smooth-map-regular-model-RLCT-d/2) (stv 0.8 0.85)))\n\n(|- ((==> (And (> (Cardinality (ZeroCountContexts $n)) 0) (> $k 0))\n          (< (RLCT $n $V) (RLCT-smoothed $n $V))) (stv 0.6 0.75))\n    ((Singular-RLCT-less-than-d/2) (stv 0.8 0.85))\n    ((Smoothed-RLCT-equals-d/2) (stv 0.8 0.85)))\n\n(|- ((==> (KneserNey $D $c $w $n)\n          (HierarchicalDesingularization $n)) (stv 0.5 0.7))\n    ((KN-recursion-blow-up) (stv 0.5 0.7))\n    ((Iterated-resolution-analogy) (stv 0.4 0.6)))\n\n;; C5 (CONJECTURAL): Phase transition at n* detectable via SGLD\n(|- ((==> (SGLD-on-ngram $n $V)\n          (LLCProfile $n (CriticalOrder $V $n_samples))) (stv 0.5 0.7))\n    ((Ngram-gradient-computable) (stv 1.0 0.9))\n    ((Kink-at-n-star-detectable) (stv 0.5 0.7)))\n\n;; PLN chain 1: Add-k desingularization\n(|~ ((Implication (In $c (ZeroCountContexts $n))\n                 (ZeroFisherInfo $c)) (stv 1.0 0.9))\n    ((Zero-count-no-constraint) (stv 1.0 0.95)))\n\n(|~ ((Implication (AddKSmooth $k $c $w)\n                 (PositiveDefiniteFisher (AddKSmooth $k))) (stv 0.9 0.85))\n    ((AddK-denominator-positive) (stv 1.0 0.95))\n    ((Smooth-map-regular) (stv 0.85 0.8)))\n\n;; PLN chain 2: KN hierarchical desingularization\n(|~ ((Implication (KneserNey $D $c $w $n)\n                 (Resolved (ZeroCountFiber $n $V))) (stv 0.5 0.7))\n    ((KN-recursion-to-lower-order) (stv 0.8 0.85))\n    ((Lower-order-has-fewer-zero-contexts) (stv 0.7 0.8))\n    ((Iterated-blow-up-resolves) (stv 0.4 0.6)))\n\n;; Cross-references\n(Ngram-x-RLCT cross-ref #873 #268 #520 #220 #570 #877 #409 #193)\n\n;; Open problems\n(open-problem exact-zero-count-fiber-RLCT-proof)\n(open-problem inter-context-coupling-effect-on-RLCT)\n(open-problem KN-iterated-blow-up-formalization)\n(open-problem Good-Turing-R_an-subanalyticity-at-N_r=0)\n(open-problem SGLD-ngram-LLC-estimation)\n(open-problem n-star-sharp-vs-smooth-crossover)\n(open-problem backoff-models-RLCT)