;; Synthesis #848: MADE × RLCT — L3 MeTTa Encoding\n;; Date: 2026-11-06\n;; C1 PROVEN (stv 1.0 0.95), C2-C5 CONJECTURAL (stv 0.0 0.7)\n\n;; Type declarations\n(declare-type Mask)\n(declare-type WeightMatrix)\n(declare-type HiddenUnit)\n(declare-type Permutation)\n(declare-type Stratum)\n(declare-type Fiber)\n(declare-type RLCT)\n(declare-type Layer)\n\n;; D1: MADE Masking\n(= (made-mask W M) (* W M))\n(= (mask-valid M m) (and (= (M_ij 1) (>= (m i) (m_prev j)))))\n\n;; D2: Autoregressive Factorization\n(= (ar-factorization x theta) (product i (p_cond x_i x_lt_i theta)))\n(= (p_cond x_i x_lt_i theta) (sigmoid (masked-linear x_lt_i theta)))\n\n;; D3: Zero-Weight Stratum\n(= (zero-weight-stratum M) (set W (= (* W (- 1 M)) 0)))\n(= (effective-param-space m) (intersection Theta (complement (zero-weight-stratum M_m))))\n\n;; D4: Combinatorial Non-Identifiability\n(= (mask-permutation-group m) (product_l (Stab m_l)))\n(= (quotient-singularity V_m Gamma_m) (quotient V_m Gamma_m))\n(= (equivalent-networks theta sigma) (= (f theta) (f (sigma theta))))\n\n;; D5: Empirical Loss\n(= (empirical-loss theta n) (/ (sum k (log (ar-factorization x_k theta))) (- n)))\n(= (loss-stratum theta m) (piecewise-analytic theta (Theta_m)))\n\n;; D6: Singular Fiber\n(= (singular-fiber-mask m L_star) (set theta (Theta_m) (= (empirical-loss theta) L_star)))\n(= (full-fiber) (union_m (singular-fiber-mask m L_star)))\n\n;; D7: Real Code\n(= (real-code theta m) (local-ideal-generator theta (zero-weight-stratum M_m)))\n(= (real-code-definable) (R_an_exp (real-code theta m)))\n\n;; C1: Definability [PROVEN]\n(|- ((Implication (Inheritance MADEArchitecture (IntSet AnalyticArchitecture))\n           (Inheritance MADELoss (IntSet RAnExpDefinable))) (stv 1.0 0.95))\n          ((Inheritance MADEArchitecture (IntSet AnalyticArchitecture)) (stv 1.0 0.95)))\n\n;; C2: Mask-Induced Quotient Singularity [CONJECTURAL]\n(|~ ((Implication (Inheritance MaskPermutation (IntSet NonTrivialGroup))\n            (Implication (Inheritance QuotientSingularity (IntSet OrbifoldType))\n                         (>= (rlct-quotient) (rlct-base)))) (stv 0.0 0.7))\n           ((Inheritance MaskPermutation (IntSet NonTrivialGroup)) (stv 0.5 0.7)))\n\n;; C3: Combinatorial Stratum Complexity [CONJECTURAL]\n(|~ ((Implication (Inheritance MaskSet (IntSet CombinatorialGrowth))\n            (>= (rlct-total) (max_m (rlct-stratum m)))) (stv 0.0 0.7))\n           ((Inheritance MaskSet (IntSet CombinatorialGrowth)) (stv 0.5 0.7)))\n\n;; C4: Generalization Bound [CONJECTURAL]\n(|~ ((Implication (Inheritance ActiveMask (IntSet LowComplexityMask))\n            (< (rlct-active) (rlct-threshold))) (stv 0.0 0.7))\n           ((Inheritance ActiveMask (IntSet LowComplexityMask)) (stv 0.5 0.7)))\n\n;; C5: Mask Width vs RLCT Trade-off [CONJECTURAL]\n(|~ ((Implication (Inheritance HiddenWidth (IntSet OptimalWidth))\n            (= (rlct-total) (min_width (rlct-function d_l)))) (stv 0.0 0.7))\n           ((Inheritance HiddenWidth (IntSet OptimalWidth)) (stv 0.5 0.7)))\n\n;; Caveats\n;; 1. C1 proven only within fixed mask stratum; cross-stratum transitions unproven\n;; 2. Quotient singularity structure depends on mask-preserving subgroup, not full symmetric group\n;; 3. Combinatorial growth bound is asymptotic; finite-width behavior may differ\n;; 4. Generalization bound assumes active stratum is identifiable during training\n;; 5. U-shape in width is conjectured by analogy to #169, not formally derived\n\n;; Cross-References\n;; #134 (Attention): permutation-equivariant vs autoregressive — opposite symmetry\n;; #169 (Dropout): stochastic vs deterministic masking\n;; #258 (Mixup): input interpolation vs weight masking\n;; #383 (VAE): stochastic encoder vs deterministic mask\n;; #556 (VQ-VAE): discrete codebook vs discrete mask\n;; #580 (SSM): temporal recurrence vs autoregressive factorization